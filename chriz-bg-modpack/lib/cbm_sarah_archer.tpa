// =====================================================================
//  cbm_sarah_archer   (component @190)
//  Convert Sarah ToB v8 to Archer with the owner's chosen proficiencies
// =====================================================================

DEFINE_PATCH_FUNCTION cbm_sarah_make_archer BEGIN
  LPF cbmo_cre_writable RET cbmo_writable END
  PATCH_IF cbmo_writable BEGIN

  READ_ASCII 0x00 cbm_sarah_signature (8)
  READ_BYTE  0x33 cbm_sarah_effect_version
  READ_BYTE  0x273 cbm_sarah_class
  READ_SHORT 0x246 cbm_sarah_kit_high


  READ_LONG 0x2c4 cbm_sarah_effect_offset
  READ_LONG 0x2c8 cbm_sarah_effect_count

  // The core Archer kit is the high word 0x4007 of the CRE kit dword.
  WRITE_BYTE 0x273 12
  WRITE_LONG 0x244 0x40070000

  // Replace base and increment-mode proficiency records. Stats 109/110 are
  // repurposed EE spell-state fields and are not part of this allocation.
  LPF cbm_npc_clear_proficiencies END

  SET_BG2_PROFICIENCY 90  1 // Long Sword
  SET_BG2_PROFICIENCY 104 3 // Long Bow
  SET_BG2_PROFICIENCY 105 2 // Short Bow
  SET_BG2_PROFICIENCY 114 2 // Two-Weapon Style (intentional under Artisan too)

  END ELSE BEGIN
    PATCH_PRINT ~CBM: %SOURCE_FILE% is too damaged to write; leaving this resource alone.~
  END
END
