// Viconia owns her Cleric/Thief build and priest slot rows.
// Installed progressions are read by label, with bundled defaults for absent cells.
DEFINE_ACTION_FUNCTION cbm_viconia_load_context
  RET
    cbm_viconia_cleric_class
    cbm_viconia_cleric_thief_class
    cbm_viconia_cleric_lore_rate
    cbm_viconia_thief_lore_rate
  RET_ARRAY
    cbm_viconia_cleric_xp
    cbm_viconia_thief_xp
    cbm_viconia_priest_slots
    cbm_viconia_priest_saves
    cbm_viconia_rogue_saves
    cbm_viconia_cleric_thac0
    cbm_viconia_thief_thac0
BEGIN
  OUTER_SET cbm_viconia_cleric_class = (FILE_EXISTS_IN_GAME ~CLASS.IDS~ ? IDS_OF_SYMBOL (~class~ ~CLERIC~) : (0 - 1))
  OUTER_SET cbm_viconia_cleric_thief_class = (FILE_EXISTS_IN_GAME ~CLASS.IDS~ ? IDS_OF_SYMBOL (~class~ ~CLERIC_THIEF~) : (0 - 1))
  ACTION_IF cbm_viconia_cleric_thief_class < 0 BEGIN OUTER_SET cbm_viconia_cleric_thief_class = 15 END
  ACTION_FOR_EACH table IN LORE THAC0 XPLEVEL MXSPLPRS SAVEPRS SAVEROG BEGIN
    LAF cbmo_read_table STR_VAR table RET_ARRAY cbmo_cell cbmo_column cbmo_cols END
  END
  OUTER_PATCH ~~ BEGIN
    LPF cbmo_number INT_VAR fallback = 1 STR_VAR table = ~LORE~ row = ~CLERIC~ column = ~RATE~ RET cbm_viconia_cleric_lore_rate = number END
    LPF cbmo_number INT_VAR fallback = 3 STR_VAR table = ~LORE~ row = ~THIEF~ column = ~RATE~ RET cbm_viconia_thief_lore_rate = number END
    FOR (level = 1; level <= 50; ++level) BEGIN
      PATCH_FOR_EACH class IN CLERIC THIEF BEGIN
        LPF cbmo_number INT_VAR fallback = 2147483647 STR_VAR table = ~XPLEVEL~ row = EVAL ~%class%~ column = EVAL ~%level%~ RET number END
        PATCH_IF ~%class%~ STRING_EQUAL ~CLERIC~ BEGIN
          SET $cbm_viconia_cleric_xp(~%level%~) = number < 0 ? 2147483647 : number
        END ELSE BEGIN
          SET $cbm_viconia_thief_xp(~%level%~) = number < 0 ? 2147483647 : number
        END
        SET previous = level - 1
        SET fallback = 20
        PATCH_IF level > 1 BEGIN
          PATCH_IF ~%class%~ STRING_EQUAL ~CLERIC~ BEGIN SET fallback = $cbm_viconia_cleric_thac0(~%previous%~) END
          ELSE BEGIN SET fallback = $cbm_viconia_thief_thac0(~%previous%~) END
        END
        LPF cbmo_number INT_VAR fallback STR_VAR table = ~THAC0~ row = EVAL ~%class%~ column = EVAL ~%level%~ RET number END
        PATCH_IF ~%class%~ STRING_EQUAL ~CLERIC~ BEGIN SET $cbm_viconia_cleric_thac0(~%level%~) = number END
        ELSE BEGIN SET $cbm_viconia_thief_thac0(~%level%~) = number END
      END
      FOR (spell_level = 1; spell_level <= 7; ++spell_level) BEGIN
        SET fallback = 0
        PATCH_IF level > 1 BEGIN SET fallback = $cbm_viconia_priest_slots(~%previous%_%spell_level%~) END
        LPF cbmo_number INT_VAR fallback STR_VAR table = ~MXSPLPRS~ row = EVAL ~%level%~ column = EVAL ~%spell_level%~ RET number END
        SET $cbm_viconia_priest_slots(~%level%_%spell_level%~) = number < 0 ? 0 : (number > 65535 ? 65535 : number)
      END
      PATCH_FOR_EACH category IN DEATH WANDS POLY BREATH SPELL BEGIN
        SET fallback = 20
        PATCH_IF level > 1 BEGIN SET fallback = $cbm_viconia_priest_saves(~%category%_%previous%~) END
        LPF cbmo_number INT_VAR fallback STR_VAR table = ~SAVEPRS~ row = EVAL ~%category%~ column = EVAL ~%level%~ RET number END
        SET $cbm_viconia_priest_saves(~%category%_%level%~) = number
        SET fallback = 20
        PATCH_IF level > 1 BEGIN SET fallback = $cbm_viconia_rogue_saves(~%category%_%previous%~) END
        LPF cbmo_number INT_VAR fallback STR_VAR table = ~SAVEROG~ row = EVAL ~%category%~ column = EVAL ~%level%~ RET number END
        SET $cbm_viconia_rogue_saves(~%category%_%level%~) = number
      END
    END
  END
END

DEFINE_PATCH_FUNCTION cbm_viconia_make_cleric_thief BEGIN
  LPF cbmo_cre_writable RET cbmo_writable END
  PATCH_IF cbmo_writable BEGIN

  READ_ASCII 0x00 cbm_viconia_signature (8)
  READ_ASCII 0x280 cbm_viconia_dv (32) NULL
  READ_BYTE  0x273 cbm_viconia_class
  READ_LONG  0x244 cbm_viconia_kit
  READ_LONG  0x18 cbm_viconia_total_xp


  // Multiclass characters split total XP equally; WeiDU integer division is
  // the engine-compatible floor operation for odd totals.
  SET cbm_viconia_class_xp = cbm_viconia_total_xp / 2
  SET cbm_viconia_cleric_level = 1
  SET cbm_viconia_thief_level = 1
  FOR (cbm_viconia_level = 1; cbm_viconia_level <= 50; cbm_viconia_level += 1) BEGIN
    PATCH_IF ($cbm_viconia_cleric_xp(~%cbm_viconia_level%~) <= cbm_viconia_class_xp) BEGIN
      SET cbm_viconia_cleric_level = cbm_viconia_level
    END
    PATCH_IF ($cbm_viconia_thief_xp(~%cbm_viconia_level%~) <= cbm_viconia_class_xp) BEGIN
      SET cbm_viconia_thief_level = cbm_viconia_level
    END
  END


  // Multiclass THAC0 uses the better (lower) installed class progression at
  // the exact split levels this component serializes.
  SET cbm_viconia_thac0 = $cbm_viconia_cleric_thac0(~%cbm_viconia_cleric_level%~)
  SET cbm_viconia_rogue_thac0 = $cbm_viconia_thief_thac0(~%cbm_viconia_thief_level%~)
  PATCH_IF (cbm_viconia_rogue_thac0 < cbm_viconia_thac0) BEGIN
    SET cbm_viconia_thac0 = cbm_viconia_rogue_thac0
  END

  // Treat the level-1 40 points and every later 25-point pool alike: invest
  // only in Find Traps and Open Locks, split evenly in five-point chunks.
  // When the budget contains an odd chunk, Find Traps receives it.
  SET cbm_viconia_skill_budget = 40 + (25 * (cbm_viconia_thief_level - 1))
  SET cbm_viconia_hide = 0
  SET cbm_viconia_move = 0
  SET cbm_viconia_find = ((cbm_viconia_skill_budget + 5) / 10) * 5
  SET cbm_viconia_locks = cbm_viconia_skill_budget - cbm_viconia_find


  // Raw Lore is cumulative across both multiclass progressions. Saving throws
  // use the better (lower) installed class value for each category.
  SET cbm_viconia_lore = (cbm_viconia_cleric_lore_rate * cbm_viconia_cleric_level) + (cbm_viconia_thief_lore_rate * cbm_viconia_thief_level)

  SET cbm_viconia_save_death = $cbm_viconia_priest_saves(~DEATH_%cbm_viconia_cleric_level%~)
  SET cbm_viconia_rogue_save = $cbm_viconia_rogue_saves(~DEATH_%cbm_viconia_thief_level%~)
  PATCH_IF (cbm_viconia_rogue_save < cbm_viconia_save_death) BEGIN
    SET cbm_viconia_save_death = cbm_viconia_rogue_save
  END
  SET cbm_viconia_save_wands = $cbm_viconia_priest_saves(~WANDS_%cbm_viconia_cleric_level%~)
  SET cbm_viconia_rogue_save = $cbm_viconia_rogue_saves(~WANDS_%cbm_viconia_thief_level%~)
  PATCH_IF (cbm_viconia_rogue_save < cbm_viconia_save_wands) BEGIN
    SET cbm_viconia_save_wands = cbm_viconia_rogue_save
  END
  SET cbm_viconia_save_poly = $cbm_viconia_priest_saves(~POLY_%cbm_viconia_cleric_level%~)
  SET cbm_viconia_rogue_save = $cbm_viconia_rogue_saves(~POLY_%cbm_viconia_thief_level%~)
  PATCH_IF (cbm_viconia_rogue_save < cbm_viconia_save_poly) BEGIN
    SET cbm_viconia_save_poly = cbm_viconia_rogue_save
  END
  SET cbm_viconia_save_breath = $cbm_viconia_priest_saves(~BREATH_%cbm_viconia_cleric_level%~)
  SET cbm_viconia_rogue_save = $cbm_viconia_rogue_saves(~BREATH_%cbm_viconia_thief_level%~)
  PATCH_IF (cbm_viconia_rogue_save < cbm_viconia_save_breath) BEGIN
    SET cbm_viconia_save_breath = cbm_viconia_rogue_save
  END
  SET cbm_viconia_save_spell = $cbm_viconia_priest_saves(~SPELL_%cbm_viconia_cleric_level%~)
  SET cbm_viconia_rogue_save = $cbm_viconia_rogue_saves(~SPELL_%cbm_viconia_thief_level%~)
  PATCH_IF (cbm_viconia_rogue_save < cbm_viconia_save_spell) BEGIN
    SET cbm_viconia_save_spell = cbm_viconia_rogue_save
  END

  WRITE_LONG 0x244 0x40000000
  WRITE_BYTE 0x273 cbm_viconia_cleric_thief_class
  WRITE_BYTE 0x234 cbm_viconia_cleric_level
  WRITE_BYTE 0x235 cbm_viconia_thief_level
  WRITE_BYTE 0x236 0
  WRITE_BYTE 0x52 cbm_viconia_thac0

  WRITE_BYTE 0x54 cbm_viconia_save_death
  WRITE_BYTE 0x55 cbm_viconia_save_wands
  WRITE_BYTE 0x56 cbm_viconia_save_poly
  WRITE_BYTE 0x57 cbm_viconia_save_breath
  WRITE_BYTE 0x58 cbm_viconia_save_spell
  WRITE_BYTE 0x66 (cbm_viconia_lore > 255 ? 255 : (cbm_viconia_lore < 0 ? 0 : cbm_viconia_lore))

  WRITE_BYTE 0x45 cbm_viconia_hide
  WRITE_BYTE 0x64 0
  WRITE_BYTE 0x65 0
  WRITE_BYTE 0x67 (cbm_viconia_locks > 255 ? 255 : (cbm_viconia_locks < 0 ? 0 : cbm_viconia_locks))
  WRITE_BYTE 0x68 cbm_viconia_move
  WRITE_BYTE 0x69 (cbm_viconia_find > 255 ? 255 : (cbm_viconia_find < 0 ? 0 : cbm_viconia_find))
  WRITE_BYTE 0x6a 0


  // Own one priest row per level. Merge duplicate slices, keep spell records
  // and unrelated rows, and add rows that another mod removed.
  READ_LONG 0x2a8 info
  READ_LONG 0x2ac infos
  READ_LONG 0x2b0 spells
  READ_LONG 0x2b4 spell_count
  SPRINT new_info ~~
  SPRINT new_spells ~~
  SET new_count = 0
  SET new_infos = 0
  FOR (level = 0; level < 7; ++level) BEGIN
    SET first = new_count
    SET bonus = 0
    FOR (i = 0; i < infos; ++i) BEGIN
      SET at = info + i * 16
      PATCH_IF SHORT_AT (at + 6) = 0 AND SHORT_AT at = level BEGIN
        SET delta = SHORT_AT (at + 4) - SHORT_AT (at + 2)
        SET bonus = delta > bonus ? delta : bonus
        SET from = LONG_AT (at + 8)
        SET count = LONG_AT (at + 12)
        SET from = from < 0 ? 0 : (from > spell_count ? spell_count : from)
        SET count = count < 0 ? 0 : (count > spell_count - from ? spell_count - from : count)
        READ_ASCII (spells + from * 12) records (count * 12)
        SPRINT new_spells ~%new_spells%%records%~
        SET new_count += count
      END
    END
    SET spell_level = level + 1
    SET base = $cbm_viconia_priest_slots(~%cbm_viconia_cleric_level%_%spell_level%~)
    INNER_PATCH_SAVE record ~~ BEGIN
      INSERT_BYTES 0 16
      WRITE_SHORT 0 level
      WRITE_SHORT 2 base
      WRITE_SHORT 4 (base + bonus > 65535 ? 65535 : base + bonus)
      WRITE_LONG 8 first
      WRITE_LONG 12 (new_count - first)
    END
    SPRINT new_info ~%new_info%%record%~
    SET new_infos += 1
  END
  FOR (i = 0; i < infos; ++i) BEGIN
    SET at = info + i * 16
    PATCH_IF SHORT_AT (at + 6) != 0 BEGIN
      READ_ASCII at record (16)
      SET from = LONG_AT (at + 8)
      SET count = LONG_AT (at + 12)
      SET from = from < 0 ? 0 : (from > spell_count ? spell_count : from)
      SET count = count < 0 ? 0 : (count > spell_count - from ? spell_count - from : count)
      INNER_PATCH_SAVE record ~%record%~ BEGIN
        WRITE_LONG 8 new_count
        WRITE_LONG 12 count
      END
      SPRINT new_info ~%new_info%%record%~
      READ_ASCII (spells + from * 12) records (count * 12)
      SPRINT new_spells ~%new_spells%%records%~
      SET new_infos += 1
      SET new_count += count
    END
  END
  LPF cbmo_replace_cre_block INT_VAR pointer = 0x2a8 count_pointer = 0x2ac stride = 16 new_count = new_infos STR_VAR replacement = EVAL ~%new_info%~ END
  LPF cbmo_replace_cre_block INT_VAR pointer = 0x2b0 count_pointer = 0x2b4 stride = 12 new_count STR_VAR replacement = EVAL ~%new_spells%~ END
  END ELSE BEGIN
    PATCH_PRINT ~CBM: %SOURCE_FILE% is too damaged to write; leaving this resource alone.~
  END
END
