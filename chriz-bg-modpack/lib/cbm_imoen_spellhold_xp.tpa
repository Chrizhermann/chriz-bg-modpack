// EEex supplies the exact runtime average; native BCS only offers fixed XP tests.
ACTION_IF (FILE_EXISTS_IN_GAME ~ACTION.IDS~ ? IDS_OF_SYMBOL (~action~ ~EEex_LuaAction~) : (0 - 1)) >= 0 BEGIN
  COPY ~chriz-bg-modpack/imoen-xp/m_cbmixp.lua~ ~override/M_CBMIXP.lua~
  COPY_EXISTING ~imoen2.bcs~ ~override~
    LPF cbmo_script_block STR_VAR replacement = ~chriz-bg-modpack/baf/cbm_imoen_spellhold_xp.baf~ END
  BUT_ONLY
  PRINT @1623
END ELSE BEGIN PRINT ~Imoen XP: EEex_LuaAction is unavailable; this listener cannot run.~ END
