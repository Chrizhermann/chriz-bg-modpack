// EEex supplies the exact runtime average; native BCS only offers fixed XP tests.
ACTION_IF (NOT FILE_EXISTS_IN_GAME ~action.ids~) BEGIN
  FAIL @1621
END
ACTION_IF (IDS_OF_SYMBOL (~action~ ~EEex_LuaAction~) != 472) BEGIN
  FAIL @1621
END

COPY ~chriz-bg-modpack/imoen-xp/m_cbmixp.lua~ ~override/M_CBMIXP.lua~
// Run before vanilla's 1.25M ceiling and EET's retired-thief subtraction.
// Keep every existing block, including other mods' dialogue and quest logic.
EXTEND_TOP ~imoen2.bcs~ ~chriz-bg-modpack/baf/cbm_imoen_spellhold_xp.baf~
PRINT @1623
