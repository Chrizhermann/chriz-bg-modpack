// Own the charge count of Branwen's magical-weapon ability.
ACTION_IF FILE_EXISTS_IN_GAME ~SPIN113.SPL~ BEGIN
  COPY_EXISTING ~SPIN113.SPL~ ~override~
    LPF cbmo_own_spell_effect INT_VAR opcode = 111 param1 = 1
        STR_VAR default_resource = ~SHAMMR~ END
    LPF cbmo_write_description END
  BUT_ONLY
END ELSE BEGIN PRINT ~Branwen: SPIN113.SPL is absent.~ END
PRINT ~[cbm_branwen_hammer_fix] SPIN113 magical-weapon creation uses one charge.~
