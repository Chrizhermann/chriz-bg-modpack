// SPIN113 creates a magical weapon through opcode 111. On the EE engine a
// zero charge count suppresses the weapon's on-hit delivery; one charge keeps
// that delivery active. Patch only ability effects so casting hooks remain
// opaque and untouched.

ACTION_IF NOT (FILE_EXISTS_IN_GAME ~SPIN113.SPL~) BEGIN
  FAIL ~cbm_branwen_hammer_fix: SPIN113.SPL is missing~
END

COPY_EXISTING ~SPIN113.SPL~ ~override~
  READ_ASCII 0x00 cbm_branwen_signature (8)
  PATCH_IF NOT (~%cbm_branwen_signature%~ STRING_EQUAL_CASE ~SPL V1  ~) BEGIN
    PATCH_FAIL ~cbm_branwen_hammer_fix: SPIN113.SPL is not SPL V1.0~
  END

  SET cbm_branwen_create_count = 0
  SET cbm_branwen_bad_charge = 0
  GET_OFFSET_ARRAY cbm_branwen_headers SPL_V10_HEADERS
  PHP_EACH cbm_branwen_headers AS cbm_branwen_header_index => cbm_branwen_header BEGIN
    GET_OFFSET_ARRAY2 cbm_branwen_effects cbm_branwen_header SPL_V10_HEAD_EFFECTS
    PHP_EACH cbm_branwen_effects AS cbm_branwen_effect_index => cbm_branwen_effect BEGIN
      READ_SHORT cbm_branwen_effect cbm_branwen_opcode
      PATCH_IF (cbm_branwen_opcode = 111) BEGIN
        SET cbm_branwen_create_count += 1
        READ_LONG (cbm_branwen_effect + 0x04) cbm_branwen_charges
        PATCH_IF (cbm_branwen_charges = 0) BEGIN
          WRITE_LONG (cbm_branwen_effect + 0x04) 1
        END ELSE PATCH_IF NOT (cbm_branwen_charges = 1) BEGIN
          SET cbm_branwen_bad_charge = 1
        END
      END
    END
  END

  PATCH_IF (cbm_branwen_create_count = 0) BEGIN
    PATCH_FAIL ~cbm_branwen_hammer_fix: SPIN113.SPL has no ability opcode 111 to repair~
  END
  PATCH_IF cbm_branwen_bad_charge BEGIN
    PATCH_FAIL ~cbm_branwen_hammer_fix: SPIN113.SPL has an unexpected opcode 111 charge count~
  END
BUT_ONLY

PRINT ~[cbm_branwen_hammer_fix] SPIN113 magical-weapon creation uses one charge.~
