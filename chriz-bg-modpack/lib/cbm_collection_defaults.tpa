DEFINE_PATCH_FUNCTION cbm_collection_add_dynaheir_haste
  INT_VAR
    expected_class = 0
    expected_kit = 0
  STR_VAR
    expected_dv = ~~
    haste_resref = ~~
BEGIN
  LPF cbmo_cre_writable RET cbmo_writable END
  PATCH_IF cbmo_writable BEGIN
  SPRINT cbm_collection_expected_dv EVALUATE_BUFFER ~%expected_dv%~
  SPRINT cbm_collection_haste_resref EVALUATE_BUFFER ~%haste_resref%~

  PATCH_IF (~%cbm_collection_haste_resref%~ STRING_EQUAL ~~) BEGIN
    PATCH_FAIL ~Dynaheir Haste: empty resolved Haste resref~
  END

  READ_ASCII 0x00 cbm_collection_signature (8)
  READ_ASCII 0x280 cbm_collection_dv (32) NULL
  READ_BYTE  0x273 cbm_collection_class
  READ_LONG  0x244 cbm_collection_kit


  READ_LONG 0x2a0 cbm_collection_known_offset
  READ_LONG 0x2a4 cbm_collection_known_count

  // Own exactly one known Haste record, regardless of old metadata or duplicates.
  SET cbmh_first = 0 - 1
  FOR (cbmh_i = 0; cbmh_i < cbm_collection_known_count; ++cbmh_i) BEGIN
    READ_ASCII (cbm_collection_known_offset + cbmh_i * 12) cbmh_name (8) NULL
    PATCH_IF ~%cbmh_name%~ STRING_EQUAL_CASE ~%cbm_collection_haste_resref%~ BEGIN
      PATCH_IF cbmh_first < 0 BEGIN SET cbmh_first = cbmh_i END
    END
  END
  PATCH_IF cbmh_first >= 0 BEGIN
    FOR (cbmh_i = cbm_collection_known_count - 1; cbmh_i > cbmh_first; --cbmh_i) BEGIN
      SET cbmh_at = cbm_collection_known_offset + cbmh_i * 12
      READ_ASCII cbmh_at cbmh_name (8) NULL
      PATCH_IF ~%cbmh_name%~ STRING_EQUAL_CASE ~%cbm_collection_haste_resref%~ BEGIN
        DELETE_BYTES cbmh_at 12
        WRITE_LONG 0x2a4 (LONG_AT 0x2a4 - 1)
        PATCH_FOR_EACH cbmh_p IN 0x2a8 0x2b0 0x2b8 0x2bc 0x2c4 BEGIN
          PATCH_IF LONG_AT cbmh_p >= cbmh_at + 12 BEGIN WRITE_LONG cbmh_p (LONG_AT cbmh_p - 12) END
        END
      END
    END
    SET cbmh_at = cbm_collection_known_offset + cbmh_first * 12
    WRITE_SHORT (cbmh_at + 8) 2
    WRITE_SHORT (cbmh_at + 10) 1
  END ELSE BEGIN
    PATCH_IF cbm_collection_known_count = 0 BEGIN WRITE_LONG 0x2a0 BUFFER_LENGTH END
    ADD_KNOWN_SPELL ~%cbm_collection_haste_resref%~ #2 ~wizard~
  END
  END ELSE BEGIN
    PATCH_PRINT ~CBM: %SOURCE_FILE% is too damaged to write; leaving this resource alone.~
  END
END
