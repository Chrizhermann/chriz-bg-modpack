DEFINE_PATCH_FUNCTION cbm_collection_add_dynaheir_haste
  INT_VAR
    expected_class = 0
    expected_kit = 0
  STR_VAR
    expected_dv = ~~
    haste_resref = ~~
BEGIN
  SPRINT cbm_collection_expected_dv EVALUATE_BUFFER ~%expected_dv%~
  SPRINT cbm_collection_haste_resref EVALUATE_BUFFER ~%haste_resref%~

  PATCH_IF (SOURCE_SIZE < 0x2d4) BEGIN
    PATCH_FAIL ~Dynaheir Haste: truncated CRE (smaller than the V1.0 header)~
  END
  PATCH_IF ((expected_class <= 0) OR (expected_class > 0xff)
         OR (expected_kit <= 0)) BEGIN
    PATCH_FAIL ~Dynaheir Haste: invalid installed class or kit context~
  END
  PATCH_IF (~%cbm_collection_expected_dv%~ STRING_EQUAL ~~) BEGIN
    PATCH_FAIL ~Dynaheir Haste: empty expected death variable~
  END
  PATCH_IF (~%cbm_collection_haste_resref%~ STRING_EQUAL ~~) BEGIN
    PATCH_FAIL ~Dynaheir Haste: empty resolved Haste resref~
  END

  READ_ASCII 0x00 cbm_collection_signature (8)
  READ_ASCII 0x280 cbm_collection_dv (32) NULL
  READ_BYTE  0x273 cbm_collection_class
  READ_LONG  0x244 cbm_collection_kit

  PATCH_IF NOT (~%cbm_collection_signature%~ STRING_EQUAL ~CRE V1.0~) BEGIN
    PATCH_FAIL ~Dynaheir Haste: expected a CRE V1.0 signature~
  END
  PATCH_IF NOT (~%cbm_collection_dv%~ STRING_EQUAL_CASE ~%cbm_collection_expected_dv%~) BEGIN
    PATCH_FAIL ~Dynaheir Haste: unexpected death variable %cbm_collection_dv%; expected %cbm_collection_expected_dv%~
  END
  PATCH_IF (cbm_collection_class != expected_class) BEGIN
    PATCH_FAIL ~Dynaheir Haste: unexpected class %cbm_collection_class%; expected installed Mage class %expected_class%~
  END
  PATCH_IF (cbm_collection_kit != expected_kit) BEGIN
    PATCH_FAIL ~Dynaheir Haste: unexpected kit %cbm_collection_kit%; expected installed Invoker kit~
  END

  READ_LONG 0x2a0 cbm_collection_known_offset
  READ_LONG 0x2a4 cbm_collection_known_count
  PATCH_IF ((cbm_collection_known_offset < 0x2d4)
         OR (cbm_collection_known_offset > SOURCE_SIZE)) BEGIN
    PATCH_FAIL ~Dynaheir Haste: malformed known-spell table offset~
  END
  PATCH_IF (cbm_collection_known_count > ((SOURCE_SIZE - cbm_collection_known_offset) / 12)) BEGIN
    PATCH_FAIL ~Dynaheir Haste: malformed known-spell table count~
  END

  SET cbm_collection_haste_count = 0
  FOR (cbm_collection_i = 0;
       cbm_collection_i < cbm_collection_known_count;
       cbm_collection_i += 1) BEGIN
    SET cbm_collection_known_record = cbm_collection_known_offset + (cbm_collection_i * 12)
    READ_ASCII cbm_collection_known_record cbm_collection_known_resref (8) NULL
    PATCH_IF (~%cbm_collection_known_resref%~ STRING_EQUAL_CASE ~%cbm_collection_haste_resref%~) BEGIN
      READ_SHORT (cbm_collection_known_record + 0x08) cbm_collection_known_level
      READ_SHORT (cbm_collection_known_record + 0x0a) cbm_collection_known_type
      PATCH_IF ((cbm_collection_known_level != 2)
             OR (cbm_collection_known_type != 1)) BEGIN
        PATCH_FAIL ~Dynaheir Haste: existing Haste entry has unexpected level or spell-type metadata~
      END
      SET cbm_collection_haste_count += 1
    END
  END

  PATCH_IF (cbm_collection_haste_count > 1) BEGIN
    PATCH_FAIL ~Dynaheir Haste: duplicate Haste entries found; expected exactly once~
  END
  PATCH_IF (cbm_collection_haste_count = 0) BEGIN
    ADD_KNOWN_SPELL ~%cbm_collection_haste_resref%~ #2 ~wizard~
  END

  // Prove the mutation's semantic postcondition before publishing the copy.
  READ_LONG 0x2a0 cbm_collection_known_offset
  READ_LONG 0x2a4 cbm_collection_known_count
  SET cbm_collection_haste_count = 0
  FOR (cbm_collection_i = 0;
       cbm_collection_i < cbm_collection_known_count;
       cbm_collection_i += 1) BEGIN
    SET cbm_collection_known_record = cbm_collection_known_offset + (cbm_collection_i * 12)
    READ_ASCII cbm_collection_known_record cbm_collection_known_resref (8) NULL
    PATCH_IF (~%cbm_collection_known_resref%~ STRING_EQUAL_CASE ~%cbm_collection_haste_resref%~) BEGIN
      READ_SHORT (cbm_collection_known_record + 0x08) cbm_collection_known_level
      READ_SHORT (cbm_collection_known_record + 0x0a) cbm_collection_known_type
      PATCH_IF ((cbm_collection_known_level != 2)
             OR (cbm_collection_known_type != 1)) BEGIN
        PATCH_FAIL ~Dynaheir Haste: Haste postcondition has invalid metadata~
      END
      SET cbm_collection_haste_count += 1
    END
  END
  PATCH_IF (cbm_collection_haste_count != 1) BEGIN
    PATCH_FAIL ~Dynaheir Haste: failed to establish exactly one known Haste spell~
  END
END
