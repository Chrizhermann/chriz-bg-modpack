// Dorn's BG1 ambush can leave the camera locked on Senjak.
//
// The ambush cutscene CUTDN1B runs LockScroll() as its cutscene actor, Senjak,
// and then starts Dorn's dialogue. Nothing in the cutscene releases that lock.
// Only SENJACK.BCS does, after the conversation reaches its last state
// (senjack_combat) while Senjak is still neutral. When the conversation stalls,
// leaving the area unloads it and deletes Senjak. The engine never clears the
// camera-follow target on an area change, so the next frame dereferences the
// deleted creature and the game crashes.
//
// 1. CUTDN1B.BCS: remove every LockScroll() action. The cutscene never releases
//    its own lock, and the dialogue it starts centres on the speakers anyway.
//    The action records are removed from the compiled script itself, so every
//    other block, trigger and action keeps its exact bytes, including other
//    mods' additions. Area names are never read (BG:EE uses AR####, EET BG####).
//    A cutscene without LockScroll() is already fixed and stays untouched.
// 2. SENJACK.BCS: prepend a one-shot block that runs UnlockScroll() once
//    Senjak is no longer neutral, whatever made him hostile, then continues to
//    his existing blocks. His original hostility block is unchanged. A script
//    that already has this block stays untouched. Without SENJACK.BCS only the
//    cutscene changes.
//
// A missing or unreadable script affects only that script.

// head:   the start of any LockScroll() action, whitespace-tolerant
// record: one complete compiled action record. Its eight lines are AC, the
//         action number with the opener of object 1, object 1, the opener and
//         body of objects 2 and 3, then the parameters closed by AC. Object
//         bodies never span lines. Either line ending is accepted.
DEFINE_PATCH_FUNCTION cbm_dorn_ambush_patterns
  RET
    head
    record
BEGIN
  TEXT_SPRINT nl ~%MNL%?%LNL%~
  TEXT_SPRINT line ~[^%MNL%%LNL%]*~
  TEXT_SPRINT head ~AC[ %TAB%]*%nl%[ %TAB%]*135[ %TAB%]*OB~
  TEXT_SPRINT ws ~[ %TAB%]*~
  TEXT_SPRINT record ~AC%ws%%nl%%ws%135%ws%OB%ws%%nl%%line%OB%ws%%nl%%ws%OB%ws%%nl%%line%OB%ws%%nl%%ws%OB%ws%%nl%%line%OB%ws%%nl%%line%AC%ws%%nl%~
END

// Scan a compiled BCS buffer.
// status: 0 valid, 1 not a compiled BCS, 2 a LockScroll() action has an
//         unrecognized record layout
// locks:   LockScroll() actions (engine action 135 in every EE ACTION.IDS)
// records: those that are complete, removable action records
// marked:  mentions of the SENJACK.BCS release block's variable
DEFINE_PATCH_FUNCTION cbm_dorn_ambush_scan
  RET
    status
    reason
    locks
    records
    marked
BEGIN
  LPF cbm_dorn_ambush_patterns RET head = head record = record END
  SET status = 0
  TEXT_SPRINT reason ~~
  SET locks = 0
  SET records = 0
  SET marked = 0
  PATCH_IF BUFFER_LENGTH < 6 BEGIN
    SET status = 1
    TEXT_SPRINT reason ~the file is shorter than an empty script~
  END ELSE BEGIN
    READ_ASCII 0 signature (2)
    READ_BYTE 2 first
    READ_BYTE 3 second
    PATCH_IF NOT (~%signature%~ STRING_EQUAL ~SC~) OR NOT (first = 10 OR (first = 13 AND second = 10)) BEGIN
      SET status = 1
      TEXT_SPRINT reason ~the SC script header is missing~
    END
  END
  PATCH_IF status = 0 BEGIN
    SET tail_end = BUFFER_LENGTH
    SET trimming = 1
    WHILE trimming AND tail_end > 0 BEGIN
      READ_BYTE (tail_end - 1) ch
      PATCH_IF ch = 10 OR ch = 13 OR ch = 32 OR ch = 9 BEGIN
        SET tail_end -= 1
      END ELSE BEGIN
        SET trimming = 0
      END
    END
    PATCH_IF tail_end < 4 BEGIN
      SET status = 1
      TEXT_SPRINT reason ~the SC script footer is missing~
    END ELSE BEGIN
      READ_ASCII (tail_end - 2) footer (2)
      PATCH_IF NOT (~%footer%~ STRING_EQUAL ~SC~) BEGIN
        SET status = 1
        TEXT_SPRINT reason ~the SC script footer is missing~
      END
    END
  END
  PATCH_IF status = 0 BEGIN
    COUNT_REGEXP_INSTANCES CASE_SENSITIVE ~%head%~ locks
    COUNT_REGEXP_INSTANCES CASE_SENSITIVE ~%record%~ records
    COUNT_REGEXP_INSTANCES CASE_INSENSITIVE EXACT_MATCH ~CBM_DornAmbushUnlock~ marked
    PATCH_IF locks != records BEGIN
      SET status = 2
    END
  END
END

// Remove every complete LockScroll() action record; nothing else changes.
DEFINE_PATCH_FUNCTION cbm_dorn_ambush_remove_locks
  RET
    removed
BEGIN
  LPF cbm_dorn_ambush_patterns RET record = record END
  COUNT_REGEXP_INSTANCES CASE_SENSITIVE ~%record%~ removed
  REPLACE_TEXTUALLY CASE_SENSITIVE ~%record%~ ~~
END

ACTION_FOR_EACH cbm_dac_file IN CUTDN1B SENJACK BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%cbm_dac_file%.BCS~ BEGIN
    COPY_EXISTING ~%cbm_dac_file%.BCS~ ~override~
      PATCH_IF BUFFER_LENGTH >= 6 BEGIN READ_ASCII 0 cbm_dac_signature (2) END
      ELSE BEGIN SPRINT cbm_dac_signature ~~ END
      PATCH_IF ~%cbm_dac_signature%~ STRING_EQUAL ~SC~ BEGIN
        PATCH_IF ~%cbm_dac_file%~ STRING_EQUAL ~CUTDN1B~ BEGIN
          LPF cbm_dorn_ambush_scan RET cbm_dac_status = status END
          PATCH_IF cbm_dac_status = 0 BEGIN
            LPF cbm_dorn_ambush_remove_locks RET cbm_dac_removed = removed END
            PATCH_PRINT ~Removed %cbm_dac_removed% camera lock(s) from CUTDN1B.BCS.~
          END ELSE BEGIN PATCH_PRINT ~Dorn ambush: %SOURCE_FILE% is too damaged to write.~ END
        END ELSE BEGIN
          LPF cbm_dorn_ambush_scan RET cbm_dac_status = status END
          PATCH_IF cbm_dac_status = 0 BEGIN
            LPF cbmo_script_block STR_VAR replacement = ~chriz-bg-modpack/baf/cbm_dorn_ambush_senjack.baf~ marker = ~CBM_DornAmbushUnlock~ END
          END ELSE BEGIN PATCH_PRINT ~Dorn ambush: %SOURCE_FILE% is too damaged to write.~ END
        END
      END ELSE BEGIN PATCH_PRINT ~Dorn ambush: %SOURCE_FILE% is too damaged to write.~ END
    BUT_ONLY
  END ELSE BEGIN PRINT ~Dorn ambush: %cbm_dac_file%.BCS is absent.~ END
END
