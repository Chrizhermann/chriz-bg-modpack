// Component 239 owns EET's SoA protagonist ladder and ToB 2.5M catch-up.
// Party-table DVs, transition scripts and CRE override fields locate actors.
// Old catch-up blocks are replaced; unrelated story blocks remain. Empty
// override fields receive an owned script. Both ladders carry campaign guards.
INCLUDE ~chriz-bg-modpack/lib/cbm_join_xp_blocks.tpa~

// The joinable DVs of a party table, in upper case. WeiDU numbers every
// non-blank 2DA line: signature, default value, column names, then the rows.
DEFINE_PATCH_FUNCTION cbm_eet_join_xp_dvs
  RET_ARRAY dvs
BEGIN
  CLEAR_ARRAY dvs
  // Read labeled data rows even when the optional default line is blank.
  REPLACE_EVALUATE ~\([^%LNL%%MNL%]+\)~ BEGIN
    INNER_PATCH ~%MATCH1%~ BEGIN
      REPLACE_TEXTUALLY ~//.*~ ~~
      COUNT_2DA_COLS cbmjt_width
      PATCH_IF cbmjt_width > 1 BEGIN
        READ_2DA_ENTRY 0 0 1 cbmjt_dv
        TO_UPPER cbmjt_dv
        PATCH_IF NOT (~%cbmjt_dv%~ STRING_EQUAL ~2DA~) AND NOT (~%cbmjt_dv%~ STRING_EQUAL ~POST_DIALOG_FILE~) BEGIN
          SET $dvs(~%cbmjt_dv%~) = 1
        END
      END
    END
  END ~%MATCH1%~
END

DEFINE_ACTION_FUNCTION cbm_eet_join_xp BEGIN
  // 1. Each campaign's party table.
  OUTER_SPRINT cbmj_soa_table ~PDIALOG~
  OUTER_SPRINT cbmj_tob_table ~25DIALOG~
  ACTION_IF FILE_EXISTS_IN_GAME ~CAMPAIGN.2DA~ BEGIN
  COPY_EXISTING - ~CAMPAIGN.2DA~ ~.../cbmj-campaign~
    READ_2DA_ENTRIES_NOW cbmj_campaign 1
    READ_2DA_ENTRY_FORMER cbmj_campaign 0 0 cbmj_signature
    // Column names have no entry for the row names.
    SET cbmj_column = 0
    SET cbmj_index = 0
    WHILE VARIABLE_IS_SET $cbmj_campaign(~2~ ~%cbmj_index%~) BEGIN
      READ_2DA_ENTRY_FORMER cbmj_campaign 2 cbmj_index cbmj_name
      PATCH_IF cbmj_column = 0 AND (~%cbmj_name%~ STRING_EQUAL_CASE ~PDIALOG~) BEGIN
        SET cbmj_column = cbmj_index + 1
      END
      SET cbmj_index += 1
    END
    FOR (cbmj_row = 3; cbmj_row < cbmj_campaign; ++cbmj_row) BEGIN
      READ_2DA_ENTRY_FORMER cbmj_campaign cbmj_row 0 cbmj_name
      PATCH_IF cbmj_column > 0 AND VARIABLE_IS_SET $cbmj_campaign(~%cbmj_row%~ ~%cbmj_column%~) BEGIN
        READ_2DA_ENTRY_FORMER cbmj_campaign cbmj_row cbmj_column cbmj_value
        PATCH_IF ~%cbmj_name%~ STRING_EQUAL_CASE ~SOA~ BEGIN SPRINT cbmj_soa_table ~%cbmj_value%~ END
        PATCH_IF ~%cbmj_name%~ STRING_EQUAL_CASE ~TOB~ BEGIN SPRINT cbmj_tob_table ~%cbmj_value%~ END
      END
    END
  END ELSE BEGIN PRINT ~EET join XP: CAMPAIGN.2DA is absent; using PDIALOG and 25DIALOG.~ END
  ACTION_CLEAR_ARRAY cbmj_soa_dvs
  ACTION_IF FILE_EXISTS_IN_GAME ~%cbmj_soa_table%.2DA~ BEGIN
  COPY_EXISTING - ~%cbmj_soa_table%.2DA~ ~.../cbmj-soa~
    LPF cbm_eet_join_xp_dvs RET_ARRAY cbmj_soa_dvs = dvs END
  END ELSE BEGIN PRINT ~EET join XP: %cbmj_soa_table%.2DA is absent.~ END
  ACTION_CLEAR_ARRAY cbmj_tob_dvs
  ACTION_IF FILE_EXISTS_IN_GAME ~%cbmj_tob_table%.2DA~ BEGIN
  COPY_EXISTING - ~%cbmj_tob_table%.2DA~ ~.../cbmj-tob~
    LPF cbm_eet_join_xp_dvs RET_ARRAY cbmj_tob_dvs = dvs END
  END ELSE BEGIN PRINT ~EET join XP: %cbmj_tob_table%.2DA is absent.~ END

  // 2. SoA override scripts, named by EET's party block. EET writes it to
  // override; GLOB also covers an install whose override was moved to BIFFs.
  ACTION_CLEAR_ARRAY cbmj_candidates
  COPY_EXISTING_REGEXP GLOB ~^.+\.BCS$~ ~override~
    PATCH_IF INDEX_BUFFER (~PartyBG2~) >= 0 BEGIN
      SPRINT cbmj_script ~%SOURCE_RES%~
      TO_UPPER cbmj_script
      SET $cbmj_candidates(~%cbmj_script%~) = 1
    END
  BUT_ONLY
  ACTION_CLEAR_ARRAY cbmj_soa_scripts
  ACTION_CLEAR_ARRAY cbmj_soa_found
  ACTION_PHP_EACH cbmj_candidates AS cbmj_script => cbmj_unused BEGIN
    COPY_EXISTING - ~%cbmj_script%.BCS~ ~.../cbmj-candidate~
      LPF cbmo_bcs_writable RET cbmo_bcs_ok END
      PATCH_IF cbmo_bcs_ok BEGIN
      DECOMPILE_BCS_TO_BAF
      SET cbmj_next = 0
      SET cbmj_start = INDEX_BUFFER (~^IF~ cbmj_next)
      WHILE cbmj_start >= 0 BEGIN
        SET cbmj_end = INDEX_BUFFER (~^END~ cbmj_start)
        READ_ASCII cbmj_start cbmj_block (cbmj_end - cbmj_start)
        INNER_PATCH ~%cbmj_block%~ BEGIN
          PATCH_IF INDEX_BUFFER (~^[ ]*\(InPartyAllowDead\|InParty\|I[fs]ValidForPartyDialog\(ue\)?\)(Myself)~) >= 0 BEGIN
            REPLACE_EVALUATE ~^[ ]*SetGlobal("\([^"]+\)PartyBG2","GLOBAL",1)~ BEGIN
              SPRINT cbmj_dv ~%MATCH1%~
              TO_UPPER cbmj_dv
              PATCH_IF VARIABLE_IS_SET $cbmj_soa_dvs(~%cbmj_dv%~) BEGIN
                SPRINT $cbmj_soa_scripts(~%cbmj_script%~) ~%cbmj_dv%~
                SET $cbmj_soa_found(~%cbmj_dv%~) = 1
              END
            END ~%MATCH0%~
          END
        END
        SET cbmj_next = cbmj_end + 3
        SET cbmj_start = INDEX_BUFFER (~^IF~ cbmj_next)
      END
      END ELSE BEGIN PATCH_PRINT ~EET join XP: %SOURCE_FILE% is too damaged to read.~ END
  END

  // 3. ToB override scripts: EET's transition switches and ToB-start creatures.
  ACTION_CLEAR_ARRAY cbmj_tob_scripts
  ACTION_CLEAR_ARRAY cbmj_tob_found
  ACTION_CLEAR_ARRAY cbmj_created
  ACTION_FOR_EACH cbmj_area IN AR4000 AR4500 BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%cbmj_area%.BCS~ BEGIN
    COPY_EXISTING - ~%cbmj_area%.BCS~ ~.../cbmj-area~
      LPF cbmo_bcs_writable RET cbmo_bcs_ok END
      PATCH_IF cbmo_bcs_ok BEGIN
      DECOMPILE_BCS_TO_BAF
      REPLACE_EVALUATE ~ActionOverride("\([^"]+\)",ChangeAIScript("\([^"]+\)",OVERRIDE))~ BEGIN
        SPRINT cbmj_dv ~%MATCH1%~
        SPRINT cbmj_script ~%MATCH2%~
        TO_UPPER cbmj_dv
        TO_UPPER cbmj_script
        PATCH_IF VARIABLE_IS_SET $cbmj_tob_dvs(~%cbmj_dv%~) BEGIN
          SPRINT $cbmj_tob_scripts(~%cbmj_script%~) ~%cbmj_dv%~
          SET $cbmj_tob_found(~%cbmj_dv%~) = 1
        END
      END ~%MATCH0%~
      REPLACE_EVALUATE ~CreateCreature("\([^"]+\)"~ BEGIN
        SPRINT cbmj_cre ~%MATCH1%~
        TO_UPPER cbmj_cre
        SET $cbmj_created(~%cbmj_cre%~) = 1
      END ~%MATCH0%~
      END ELSE BEGIN PATCH_PRINT ~EET join XP: %SOURCE_FILE% is too damaged to read.~ END
    END ELSE BEGIN PRINT ~EET join XP: %cbmj_area%.BCS is absent.~ END
  END
  ACTION_PHP_EACH cbmj_created AS cbmj_cre => cbmj_unused BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%cbmj_cre%.CRE~ BEGIN
      OUTER_SPRINT cbmj_dv ~~
      OUTER_SPRINT cbmj_script ~~
      COPY_EXISTING - ~%cbmj_cre%.CRE~ ~.../cbmj-cre~
        PATCH_IF BUFFER_LENGTH >= 0x2d4 BEGIN
        READ_ASCII 0 cbmj_signature (8)
        PATCH_IF ~%cbmj_signature%~ STRING_EQUAL ~CRE V1.0~ BEGIN
          READ_ASCII 0x280 cbmj_dv (32) NULL
          READ_ASCII 0x248 cbmj_script (8) NULL
          TO_UPPER cbmj_dv
          TO_UPPER cbmj_script
        END
        END
      ACTION_IF VARIABLE_IS_SET $cbmj_tob_dvs(~%cbmj_dv%~) BEGIN
        ACTION_IF NOT (~%cbmj_script%~ STRING_EQUAL ~~) AND NOT (~%cbmj_script%~ STRING_EQUAL ~NONE~) BEGIN
          OUTER_SPRINT $cbmj_tob_scripts(~%cbmj_script%~) ~%cbmj_dv%~
          OUTER_SET $cbmj_tob_found(~%cbmj_dv%~) = 1
        END
      END
    END
  END

<<<<<<<< .../cbmj-empty.bcs
SC
SC
>>>>>>>>
  OUTER_SET cbmj_next_script = 1
  COPY_EXISTING_REGEXP GLOB ~^.+\.CRE$~ ~override~
    PATCH_IF BUFFER_LENGTH >= 0x2d4 BEGIN
      READ_ASCII 0 cbmj_signature (8)
      PATCH_IF ~%cbmj_signature%~ STRING_EQUAL ~CRE V1.0~ BEGIN
      READ_ASCII 0x280 cbmj_dv (32) NULL
      READ_ASCII 0x248 cbmj_script (8) NULL
      TO_UPPER cbmj_dv TO_UPPER cbmj_script
      PATCH_IF VARIABLE_IS_SET $cbmj_soa_dvs(~%cbmj_dv%~) OR VARIABLE_IS_SET $cbmj_tob_dvs(~%cbmj_dv%~) BEGIN
        PATCH_IF ~%cbmj_script%~ STRING_EQUAL ~~ OR ~%cbmj_script%~ STRING_EQUAL ~NONE~ BEGIN
          SPRINT cbmj_script ~CBJ%cbmj_next_script%~
          WHILE FILE_EXISTS_IN_GAME ~%cbmj_script%.BCS~ BEGIN
            SET cbmj_next_script += 1
            SPRINT cbmj_script ~CBJ%cbmj_next_script%~
          END
          WRITE_ASCIIE 0x248 ~%cbmj_script%~ #8
          INNER_ACTION BEGIN COPY ~.../cbmj-empty.bcs~ ~override/%cbmj_script%.BCS~ END
          SET cbmj_next_script += 1
        END
        PATCH_IF VARIABLE_IS_SET $cbmj_soa_dvs(~%cbmj_dv%~) BEGIN
          SPRINT $cbmj_soa_scripts(~%cbmj_script%~) ~%cbmj_dv%~
          SET $cbmj_soa_found(~%cbmj_dv%~) = 1
        END
        PATCH_IF VARIABLE_IS_SET $cbmj_tob_dvs(~%cbmj_dv%~) BEGIN
          SPRINT $cbmj_tob_scripts(~%cbmj_script%~) ~%cbmj_dv%~
          SET $cbmj_tob_found(~%cbmj_dv%~) = 1
        END
      END
      END
    END
  BUT_ONLY
  ACTION_CLEAR_ARRAY cbmj_all_scripts
  ACTION_FOR_EACH cbmj_phase IN soa tob BEGIN
    ACTION_PHP_EACH EVAL ~cbmj_%cbmj_phase%_scripts~ AS cbmj_script => cbmj_dv BEGIN
      OUTER_SET $cbmj_all_scripts(~%cbmj_script%~) = 1
    END
  END
  ACTION_PHP_EACH cbmj_all_scripts AS cbmj_script => cbmj_unused BEGIN
    OUTER_SPRINT cbmj_text ~~
    ACTION_FOR_EACH cbmj_phase IN soa tob BEGIN
      ACTION_IF VARIABLE_IS_SET $EVAL ~cbmj_%cbmj_phase%_scripts~(~%cbmj_script%~) BEGIN
        COPY - ~chriz-bg-modpack/baf/cbm_eet_join_xp_%cbmj_phase%.baf~ ~.../cbmj-part~
          READ_ASCII 0 cbmj_part (BUFFER_LENGTH)
        OUTER_SPRINT cbmj_text ~%cbmj_text%%LNL%%cbmj_part%~
      END
    END
<<<<<<<< .../cbmj-replacement.baf
%cbmj_text%
>>>>>>>>
    COPY - ~.../cbmj-replacement.baf~ ~.../cbmj-evaluated.baf~ EVALUATE_BUFFER
    ACTION_IF NOT FILE_EXISTS_IN_GAME ~%cbmj_script%.BCS~ BEGIN
      COPY ~.../cbmj-empty.bcs~ ~override/%cbmj_script%.BCS~
      PRINT ~EET join XP: creating %cbmj_script%.BCS for its joinable creature.~
    END
    COPY_EXISTING ~%cbmj_script%.BCS~ ~override~
      LPF cbmo_bcs_writable RET cbmo_bcs_ok END
      PATCH_IF cbmo_bcs_ok BEGIN
        DECOMPILE_BCS_TO_BAF
        LPF cbm_join_xp_takeover INT_VAR remove_raises = 1 END
        COMPILE_BAF_TO_BCS
        LPF cbmo_script_block STR_VAR replacement = ~.../cbmj-evaluated.baf~ marker = ~BD_JOINXP~ END
      END ELSE BEGIN PATCH_PRINT ~EET join XP: %SOURCE_FILE% is too damaged to write.~ END
    BUT_ONLY
  END

  // 5. Party-table entries without a script EET switches or marks.
  ACTION_FOR_EACH cbmj_phase IN SoA ToB BEGIN
    OUTER_SPRINT cbmj_missing ~~
    ACTION_IF ~%cbmj_phase%~ STRING_EQUAL ~SoA~ BEGIN
      ACTION_PHP_EACH cbmj_soa_dvs AS cbmj_dv => cbmj_unused BEGIN
        ACTION_IF NOT VARIABLE_IS_SET $cbmj_soa_found(~%cbmj_dv%~) BEGIN
          OUTER_SPRINT cbmj_missing ~%cbmj_missing% %cbmj_dv%~
        END
      END
    END ELSE BEGIN
      ACTION_PHP_EACH cbmj_tob_dvs AS cbmj_dv => cbmj_unused BEGIN
        ACTION_IF NOT VARIABLE_IS_SET $cbmj_tob_found(~%cbmj_dv%~) BEGIN
          OUTER_SPRINT cbmj_missing ~%cbmj_missing% %cbmj_dv%~
        END
      END
    END
    ACTION_IF NOT (~%cbmj_missing%~ STRING_EQUAL ~~) BEGIN
      PRINT ~%cbmj_phase% party-table entries without an EET %cbmj_phase% script, unchanged:%cbmj_missing%~
    END
  END
END
