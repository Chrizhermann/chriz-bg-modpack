// Keldorn owns only the projectile; installed scaling stays intact.
ACTION_IF FILE_EXISTS_IN_GAME ~SPCL231.SPL~ BEGIN
  COPY_EXISTING ~SPCL231.SPL~ ~override~
    LPF cbmo_spell_layout RET cbmo_writable cbmo_headers cbmo_count END
    PATCH_IF cbmo_writable BEGIN
      FOR (cbmo_a = 0; cbmo_a < cbmo_count; ++cbmo_a) BEGIN
        WRITE_SHORT (cbmo_headers + cbmo_a * 40 + 0x26) 177
      END
    END ELSE BEGIN PATCH_PRINT ~Keldorn: %SOURCE_FILE% is too damaged to write.~ END
    LPF cbmo_write_description END
  BUT_ONLY
END ELSE BEGIN PRINT ~Keldorn: SPCL231.SPL is absent.~ END
// Yeslick owns forty explicit 1.5x dispel tiers, including the dispel effect.
ACTION_IF FILE_EXISTS_IN_GAME ~SPIN112.SPL~ BEGIN
  COPY_EXISTING ~SPIN112.SPL~ ~override~
    LPF cbmo_own_spell_effect INT_VAR opcode = 58 param2 = 2 tiers = 40
        projectile = 177 default_target = 2 END
    LPF cbmo_write_description END
  BUT_ONLY
END ELSE BEGIN PRINT ~Yeslick: SPIN112.SPL is absent.~ END
PRINT ~[cbm_yeslick_keldorn_dispel_fix] Yeslick uses 40 hostile-only 1.5x dispel levels; Keldorn is hostile-only with installed scaling preserved.~
