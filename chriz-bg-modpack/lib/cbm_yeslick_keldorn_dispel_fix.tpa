// Ability and casting effects are independently indexed slices. Their physical
// order, spacing and lengths are not fixed.
DEFINE_PATCH_FUNCTION cbm_dispel_read_layout
  STR_VAR cbm_dispel_name = ~~
  RET cbm_dispel_abilities cbm_dispel_count cbm_dispel_effects
      cbm_dispel_cast_first cbm_dispel_cast_count cbm_dispel_effect_end
BEGIN
  PATCH_IF (SOURCE_SIZE < 0x72) BEGIN
    PATCH_FAIL ~cbm_yeslick_keldorn_dispel_fix: %cbm_dispel_name% has a truncated header~
  END
  READ_ASCII 0 cbm_dispel_signature (8)
  PATCH_IF NOT (~%cbm_dispel_signature%~ STRING_EQUAL_CASE ~SPL V1  ~) BEGIN
    PATCH_FAIL ~cbm_yeslick_keldorn_dispel_fix: %cbm_dispel_name% is not SPL V1.0~
  END
  READ_LONG 0x64 cbm_dispel_abilities
  READ_SHORT 0x68 cbm_dispel_count
  READ_LONG 0x6a cbm_dispel_effects
  READ_SHORT 0x6e cbm_dispel_cast_first
  READ_SHORT 0x70 cbm_dispel_cast_count
  PATCH_IF (cbm_dispel_count < 1) OR (cbm_dispel_abilities < 0x72)
      OR (cbm_dispel_abilities > SOURCE_SIZE) OR (cbm_dispel_effects < 0x72)
      OR (cbm_dispel_effects > SOURCE_SIZE) BEGIN
    PATCH_FAIL ~cbm_yeslick_keldorn_dispel_fix: %cbm_dispel_name% has an out-of-bounds resource table~
  END
  PATCH_IF (cbm_dispel_count > (SOURCE_SIZE - cbm_dispel_abilities) / 0x28) BEGIN
    PATCH_FAIL ~cbm_yeslick_keldorn_dispel_fix: %cbm_dispel_name% has an out-of-bounds ability table~
  END
  SET cbm_dispel_header_end = cbm_dispel_abilities + cbm_dispel_count * 0x28
  SET cbm_dispel_effect_end = 0
  PATCH_IF cbm_dispel_cast_count BEGIN
    SET cbm_dispel_effect_end = cbm_dispel_cast_first + cbm_dispel_cast_count
  END
  FOR (cbm_dispel_i = 0; cbm_dispel_i < cbm_dispel_count; ++cbm_dispel_i) BEGIN
    SET cbm_dispel_header = cbm_dispel_abilities + cbm_dispel_i * 0x28
    READ_SHORT (cbm_dispel_header + 0x1e) cbm_dispel_slice_count
    READ_SHORT (cbm_dispel_header + 0x20) cbm_dispel_slice_first
    PATCH_IF (cbm_dispel_slice_count < 1) BEGIN
      PATCH_FAIL ~cbm_yeslick_keldorn_dispel_fix: %cbm_dispel_name% has an empty ability effect list~
    END
    PATCH_IF (cbm_dispel_slice_first + cbm_dispel_slice_count > cbm_dispel_effect_end) BEGIN
      SET cbm_dispel_effect_end = cbm_dispel_slice_first + cbm_dispel_slice_count
    END
  END
  PATCH_IF (cbm_dispel_effect_end > (SOURCE_SIZE - cbm_dispel_effects) / 0x30) BEGIN
    PATCH_FAIL ~cbm_yeslick_keldorn_dispel_fix: %cbm_dispel_name% has an out-of-bounds effect slice~
  END
  SET cbm_dispel_effect_bytes_end = cbm_dispel_effects + cbm_dispel_effect_end * 0x30
  PATCH_IF (cbm_dispel_effects < cbm_dispel_header_end)
      AND (cbm_dispel_effect_bytes_end > cbm_dispel_abilities) BEGIN
    PATCH_FAIL ~cbm_yeslick_keldorn_dispel_fix: %cbm_dispel_name% has overlapping ability and effect tables~
  END
END

ACTION_IF NOT (FILE_EXISTS_IN_GAME ~SPIN112.SPL~) BEGIN
  FAIL ~cbm_yeslick_keldorn_dispel_fix: SPIN112.SPL is missing~
END
ACTION_IF NOT (FILE_EXISTS_IN_GAME ~SPCL231.SPL~) BEGIN
  FAIL ~cbm_yeslick_keldorn_dispel_fix: SPCL231.SPL is missing~
END

COPY_EXISTING ~SPCL231.SPL~ ~override~
  LPF cbm_dispel_read_layout STR_VAR cbm_dispel_name = ~SPCL231.SPL~
    RET cbm_dispel_abilities cbm_dispel_count cbm_dispel_effects END
  FOR (cbm_keldorn_i = 0; cbm_keldorn_i < cbm_dispel_count; ++cbm_keldorn_i) BEGIN
    SET cbm_keldorn_header = cbm_dispel_abilities + cbm_keldorn_i * 0x28
    READ_SHORT (cbm_keldorn_header + 0x1e) cbm_keldorn_count
    READ_SHORT (cbm_keldorn_header + 0x20) cbm_keldorn_first
    SET cbm_keldorn_dispels = 0
    FOR (cbm_keldorn_j = 0; cbm_keldorn_j < cbm_keldorn_count; ++cbm_keldorn_j) BEGIN
      SET cbm_keldorn_effect = cbm_dispel_effects + (cbm_keldorn_first + cbm_keldorn_j) * 0x30
      READ_SHORT cbm_keldorn_effect cbm_keldorn_opcode
      PATCH_IF (cbm_keldorn_opcode = 58) BEGIN
        SET cbm_keldorn_dispels += 1
        READ_LONG (cbm_keldorn_effect + 0x04) cbm_keldorn_level
        READ_LONG (cbm_keldorn_effect + 0x08) cbm_keldorn_flags
        PATCH_IF (cbm_keldorn_level < 1) OR NOT ((cbm_keldorn_flags BAND 3) = 2) BEGIN
          PATCH_FAIL ~cbm_yeslick_keldorn_dispel_fix: SPCL231.SPL has unexpected opcode 58 scaling semantics~
        END
      END
    END
    PATCH_IF NOT (cbm_keldorn_dispels = 1) BEGIN
      PATCH_FAIL ~cbm_yeslick_keldorn_dispel_fix: every SPCL231.SPL ability must contain exactly one opcode 58~
    END
    // Installed scaling, casting hooks and all effect bytes remain untouched.
    WRITE_SHORT (cbm_keldorn_header + 0x26) 177
  END
BUT_ONLY

COPY_EXISTING ~SPIN112.SPL~ ~override~
  LPF cbm_dispel_read_layout STR_VAR cbm_dispel_name = ~SPIN112.SPL~
    RET cbm_dispel_abilities cbm_dispel_count cbm_dispel_effects
        cbm_dispel_cast_first cbm_dispel_cast_count cbm_dispel_effect_end END
  SET cbm_yeslick_ready = (cbm_dispel_count = 40)
  SET cbm_yeslick_previous_level = 0 - 1
  FOR (cbm_yeslick_i = 0; cbm_yeslick_i < cbm_dispel_count; ++cbm_yeslick_i) BEGIN
    SET cbm_yeslick_header = cbm_dispel_abilities + cbm_yeslick_i * 0x28
    READ_SHORT (cbm_yeslick_header + 0x10) cbm_yeslick_minimum
    READ_SHORT (cbm_yeslick_header + 0x1e) cbm_yeslick_count
    READ_SHORT (cbm_yeslick_header + 0x20) cbm_yeslick_first
    PATCH_IF (cbm_yeslick_minimum <= cbm_yeslick_previous_level)
        OR ((cbm_yeslick_i = 0) AND (cbm_yeslick_minimum > 1)) BEGIN
      PATCH_FAIL ~cbm_yeslick_keldorn_dispel_fix: SPIN112.SPL has ambiguous caster-level thresholds~
    END
    SET cbm_yeslick_previous_level = cbm_yeslick_minimum
    PATCH_IF NOT (cbm_yeslick_minimum = cbm_yeslick_i + 1) BEGIN
      SET cbm_yeslick_ready = 0
    END
    SET cbm_yeslick_dispels = 0
    FOR (cbm_yeslick_j = 0; cbm_yeslick_j < cbm_yeslick_count; ++cbm_yeslick_j) BEGIN
      READ_SHORT (cbm_dispel_effects + (cbm_yeslick_first + cbm_yeslick_j) * 0x30) cbm_yeslick_opcode
      PATCH_IF (cbm_yeslick_opcode = 58) BEGIN
        SET cbm_yeslick_dispels += 1
      END
    END
    PATCH_IF NOT (cbm_yeslick_dispels = 1) BEGIN
      PATCH_FAIL ~cbm_yeslick_keldorn_dispel_fix: every SPIN112.SPL ability must contain exactly one opcode 58~
    END
    // Shared lists are valid, but must be cloned before writing distinct levels.
    PATCH_IF cbm_yeslick_ready BEGIN
      PATCH_IF (cbm_dispel_cast_count > 0)
          AND (cbm_yeslick_first < cbm_dispel_cast_first + cbm_dispel_cast_count)
          AND (cbm_yeslick_first + cbm_yeslick_count > cbm_dispel_cast_first) BEGIN
        SET cbm_yeslick_ready = 0
      END
      FOR (cbm_yeslick_j = 0; cbm_yeslick_j < cbm_yeslick_i; ++cbm_yeslick_j) BEGIN
        SET cbm_yeslick_other = cbm_dispel_abilities + cbm_yeslick_j * 0x28
        READ_SHORT (cbm_yeslick_other + 0x1e) cbm_yeslick_other_count
        READ_SHORT (cbm_yeslick_other + 0x20) cbm_yeslick_other_first
        PATCH_IF (cbm_yeslick_first < cbm_yeslick_other_first + cbm_yeslick_other_count)
            AND (cbm_yeslick_first + cbm_yeslick_count > cbm_yeslick_other_first) BEGIN
          SET cbm_yeslick_ready = 0
        END
      END
    END
  END

  PATCH_IF NOT cbm_yeslick_ready BEGIN
    // Select installed source tiers before moving bytes. Level 40 is the
    // intentional final scaling tier, including sources with later abilities.
    SET cbm_yeslick_source = 0
    SET cbm_yeslick_new_count = 0
    FOR (cbm_yeslick_level = 1; cbm_yeslick_level <= 40; ++cbm_yeslick_level) BEGIN
      SET cbm_yeslick_choose_next = 1
      WHILE (cbm_yeslick_choose_next AND (cbm_yeslick_source + 1 < cbm_dispel_count)) BEGIN
        READ_SHORT (cbm_dispel_abilities + (cbm_yeslick_source + 1) * 0x28 + 0x10) cbm_yeslick_next_level
        PATCH_IF (cbm_yeslick_next_level <= cbm_yeslick_level) BEGIN
          SET cbm_yeslick_source += 1
        END ELSE BEGIN
          SET cbm_yeslick_choose_next = 0
        END
      END
      SET cbm_yeslick_header = cbm_dispel_abilities + cbm_yeslick_source * 0x28
      READ_SHORT (cbm_yeslick_header + 0x1e) cbm_yeslick_count
      READ_SHORT (cbm_yeslick_header + 0x20) cbm_yeslick_first
      FOR (cbm_yeslick_byte = 0; cbm_yeslick_byte < 0x28; cbm_yeslick_byte += 4) BEGIN
        READ_LONG (cbm_yeslick_header + cbm_yeslick_byte) $cbm_yeslick_headers(~%cbm_yeslick_level%~ ~%cbm_yeslick_byte%~)
      END
      SET $cbm_yeslick_sources(~%cbm_yeslick_level%~) = cbm_yeslick_first
      SET $cbm_yeslick_counts(~%cbm_yeslick_level%~) = cbm_yeslick_count
      SET cbm_yeslick_new_count += cbm_yeslick_count
    END
    // Only each first index and count is a 16-bit field. A valid final slice
    // may end beyond index 65535 as long as its first index still fits.
    SET cbm_yeslick_last_first = cbm_dispel_effect_end + cbm_yeslick_new_count - $cbm_yeslick_counts(~40~)
    PATCH_IF (cbm_yeslick_last_first > 65535) BEGIN
      PATCH_FAIL ~cbm_yeslick_keldorn_dispel_fix: SPIN112.SPL replacement exceeds the effect-index capacity~
    END

    // Expand at the actual header-table end. Retain gaps and unused records;
    // if the original has more than 40 headers its tail becomes inert data.
    PATCH_IF (cbm_dispel_count < 40) BEGIN
      SET cbm_yeslick_insert = cbm_dispel_abilities + cbm_dispel_count * 0x28
      SET cbm_yeslick_bytes = (40 - cbm_dispel_count) * 0x28
      INSERT_BYTES cbm_yeslick_insert cbm_yeslick_bytes
      PATCH_IF (cbm_dispel_effects >= cbm_yeslick_insert) BEGIN
        SET cbm_dispel_effects += cbm_yeslick_bytes
      END
    END
    // Independent slices go after the original indexed effects and before its
    // trailer. Original casting hooks, effect gaps and footer survive verbatim.
    SET cbm_yeslick_insert = cbm_dispel_effects + cbm_dispel_effect_end * 0x30
    SET cbm_yeslick_bytes = cbm_yeslick_new_count * 0x30
    INSERT_BYTES cbm_yeslick_insert cbm_yeslick_bytes
    PATCH_IF (cbm_dispel_abilities >= cbm_yeslick_insert) BEGIN
      SET cbm_dispel_abilities += cbm_yeslick_bytes
    END
    WRITE_LONG 0x64 cbm_dispel_abilities
    WRITE_SHORT 0x68 40
    WRITE_LONG 0x6a cbm_dispel_effects
    SET cbm_yeslick_first = cbm_dispel_effect_end
    FOR (cbm_yeslick_level = 1; cbm_yeslick_level <= 40; ++cbm_yeslick_level) BEGIN
      SET cbm_yeslick_header = cbm_dispel_abilities + (cbm_yeslick_level - 1) * 0x28
      SET cbm_yeslick_count = $cbm_yeslick_counts(~%cbm_yeslick_level%~)
      FOR (cbm_yeslick_byte = 0; cbm_yeslick_byte < 0x28; cbm_yeslick_byte += 4) BEGIN
        WRITE_LONG (cbm_yeslick_header + cbm_yeslick_byte) $cbm_yeslick_headers(~%cbm_yeslick_level%~ ~%cbm_yeslick_byte%~)
      END
      WRITE_SHORT (cbm_yeslick_header + 0x20) cbm_yeslick_first
      // Copy binary words, not evaluated strings: arbitrary bytes can contain
      // percent-delimited text matching a WeiDU variable.
      SET cbm_yeslick_source_first = $cbm_yeslick_sources(~%cbm_yeslick_level%~)
      FOR (cbm_yeslick_byte = 0; cbm_yeslick_byte < cbm_yeslick_count * 0x30; cbm_yeslick_byte += 4) BEGIN
        READ_LONG (cbm_dispel_effects + cbm_yeslick_source_first * 0x30 + cbm_yeslick_byte) cbm_yeslick_word
        WRITE_LONG (cbm_dispel_effects + cbm_yeslick_first * 0x30 + cbm_yeslick_byte) cbm_yeslick_word
      END
      SET cbm_yeslick_first += cbm_yeslick_count
    END
  END

  FOR (cbm_yeslick_level = 1; cbm_yeslick_level <= 40; ++cbm_yeslick_level) BEGIN
    SET cbm_yeslick_header = cbm_dispel_abilities + (cbm_yeslick_level - 1) * 0x28
    READ_SHORT (cbm_yeslick_header + 0x1e) cbm_yeslick_count
    READ_SHORT (cbm_yeslick_header + 0x20) cbm_yeslick_first
    WRITE_SHORT (cbm_yeslick_header + 0x10) cbm_yeslick_level
    WRITE_SHORT (cbm_yeslick_header + 0x26) 177
    FOR (cbm_yeslick_j = 0; cbm_yeslick_j < cbm_yeslick_count; ++cbm_yeslick_j) BEGIN
      SET cbm_yeslick_effect = cbm_dispel_effects + (cbm_yeslick_first + cbm_yeslick_j) * 0x30
      READ_SHORT cbm_yeslick_effect cbm_yeslick_opcode
      PATCH_IF (cbm_yeslick_opcode = 58) BEGIN
        WRITE_LONG (cbm_yeslick_effect + 0x04) ((cbm_yeslick_level * 3) / 2)
        WRITE_LONG (cbm_yeslick_effect + 0x08) 2
      END
    END
  END
BUT_ONLY

PRINT ~[cbm_yeslick_keldorn_dispel_fix] Yeslick uses 40 hostile-only 1.5x dispel levels; Keldorn is hostile-only with installed scaling preserved.~
