// The owner-created portrait uses Evandra EE's existing resource name, so
// epilogues and saved actors with that name also resolve the selected artwork.
// No original Evandra artwork is redistributed.
ACTION_FOR_EACH cbmep_cre IN ~RH#EVA~ ~RH#EV25~ ~RH#EVAMP~ BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%cbmep_cre%.CRE~ BEGIN
    COPY_EXISTING ~%cbmep_cre%.CRE~ ~override~
      SET cbmo_header_ok = BUFFER_LENGTH >= 0x2d4
        PATCH_IF cbmo_header_ok BEGIN
          READ_ASCII 0 cbmo_signature (8)
          SET cbmo_header_ok = ~%cbmo_signature%~ STRING_EQUAL ~CRE V1.0~
        END
        PATCH_IF cbmo_header_ok BEGIN
      WRITE_ASCII 0x34 ~rh#evaL~ #8
      WRITE_ASCII 0x3c ~rh#evaL~ #8
      END ELSE BEGIN PATCH_PRINT ~CBM: %SOURCE_FILE% is too damaged to write.~ END
    BUT_ONLY
  END ELSE BEGIN PRINT ~Evandra portrait: %cbmep_cre%.CRE is absent.~ END
END
COPY ~chriz-bg-modpack/portraits/evandra/rh#eval.bmp~ ~override/rh#eval.bmp~
