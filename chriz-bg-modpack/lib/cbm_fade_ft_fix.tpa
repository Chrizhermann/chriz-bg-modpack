// =====================================================================
// cbm_fade_ft_fix (component @110)
// Convert Fade to Fighter/Thief and subsume the old proficiency/amulet fix
// =====================================================================

DEFINE_ACTION_FUNCTION cbm_fade_load_context
  RET
    cbm_fade_thief_class
    cbm_fade_fighter_thief_class
  RET_ARRAY
    cbm_fade_fighter_xp
    cbm_fade_thief_xp
BEGIN
  OUTER_SET cbm_fade_thief_class = IDS_OF_SYMBOL (~class~ ~THIEF~)
  OUTER_SET cbm_fade_fighter_thief_class = IDS_OF_SYMBOL (~class~ ~FIGHTER_THIEF~)
  ACTION_IF ((cbm_fade_thief_class <= 0) OR (cbm_fade_thief_class > 255)
          OR (cbm_fade_fighter_thief_class <= 0) OR (cbm_fade_fighter_thief_class > 255)
          OR (cbm_fade_thief_class = cbm_fade_fighter_thief_class)) BEGIN
    FAIL ~cbm_fade_ft_fix: CLASS.IDS has invalid THIEF/FIGHTER_THIEF values~
  END

  ACTION_CLEAR_ARRAY cbm_fade_fighter_xp
  ACTION_CLEAR_ARRAY cbm_fade_thief_xp
  COPY_EXISTING ~XPLEVEL.2DA~ ~override~
    COUNT_2DA_COLS cbm_fade_xp_cols
    PATCH_IF (cbm_fade_xp_cols < 3) OR (cbm_fade_xp_cols > 257) BEGIN
      PATCH_FAIL ~cbm_fade_ft_fix: XPLEVEL.2DA must contain a class label and supported level columns~
    END

    SET cbm_fade_xp_levels = cbm_fade_xp_cols - 1
    READ_2DA_ENTRIES_NOW cbm_fade_xp_wide cbm_fade_xp_levels
    PATCH_IF (cbm_fade_xp_wide < 3) BEGIN
      PATCH_FAIL ~cbm_fade_ft_fix: XPLEVEL.2DA is missing its header or class rows~
    END
    FOR (cbm_fade_col = 0; cbm_fade_col < cbm_fade_xp_levels; cbm_fade_col += 1) BEGIN
      READ_2DA_ENTRY_FORMER cbm_fade_xp_wide 0 cbm_fade_col cbm_fade_header
      PATCH_IF (!(IS_AN_INT ~%cbm_fade_header%~)
             OR (cbm_fade_header != (cbm_fade_col + 1))) BEGIN
        PATCH_FAIL ~cbm_fade_ft_fix: XPLEVEL.2DA level header must be consecutive from 1~
      END
    END

    READ_2DA_ENTRIES_NOW cbm_fade_xp_rows cbm_fade_xp_cols
    SET cbm_fade_found_fighter = 0
    SET cbm_fade_found_thief = 0
    FOR (cbm_fade_row = 0; cbm_fade_row < cbm_fade_xp_rows; cbm_fade_row += 1) BEGIN
      READ_2DA_ENTRY_FORMER cbm_fade_xp_rows cbm_fade_row 0 cbm_fade_label
      PATCH_IF (~%cbm_fade_label%~ STRING_EQUAL_CASE ~FIGHTER~)
            OR (~%cbm_fade_label%~ STRING_EQUAL_CASE ~THIEF~) BEGIN
        PATCH_IF (~%cbm_fade_label%~ STRING_EQUAL_CASE ~FIGHTER~) BEGIN
          SET cbm_fade_found_fighter += 1
        END ELSE BEGIN
          SET cbm_fade_found_thief += 1
        END
        SET cbm_fade_previous = 0
        FOR (cbm_fade_level = 1; cbm_fade_level <= cbm_fade_xp_levels; cbm_fade_level += 1) BEGIN
          READ_2DA_ENTRY_FORMER cbm_fade_xp_rows cbm_fade_row cbm_fade_level cbm_fade_cell
          PATCH_IF (!(IS_AN_INT ~%cbm_fade_cell%~)) BEGIN
            PATCH_FAIL ~cbm_fade_ft_fix: FIGHTER/THIEF XP thresholds must be integers~
          END
          SET cbm_fade_threshold = cbm_fade_cell
          PATCH_IF (cbm_fade_threshold = (0 - 1)) BEGIN
            PATCH_IF (cbm_fade_level != cbm_fade_xp_levels) BEGIN
              PATCH_FAIL ~cbm_fade_ft_fix: FIGHTER/THIEF XP sentinel must be the final column~
            END
          END ELSE BEGIN
            PATCH_IF ((cbm_fade_threshold < 0)
                   OR ((cbm_fade_level = 1) AND (cbm_fade_threshold != 0))
                   OR ((cbm_fade_level > 1) AND (cbm_fade_threshold <= cbm_fade_previous))) BEGIN
              PATCH_FAIL ~cbm_fade_ft_fix: FIGHTER/THIEF XP rows must be complete and strictly increasing~
            END
            PATCH_IF (~%cbm_fade_label%~ STRING_EQUAL_CASE ~FIGHTER~) BEGIN
              SET $cbm_fade_fighter_xp(~%cbm_fade_level%~) = cbm_fade_threshold
            END ELSE BEGIN
              SET $cbm_fade_thief_xp(~%cbm_fade_level%~) = cbm_fade_threshold
            END
            SET cbm_fade_previous = cbm_fade_threshold
          END
        END
      END
    END
    PATCH_IF ((cbm_fade_found_fighter != 1) OR (cbm_fade_found_thief != 1)) BEGIN
      PATCH_FAIL ~cbm_fade_ft_fix: XPLEVEL.2DA needs exactly one FIGHTER and one THIEF row~
    END
  BUT_ONLY
END

// The public installer supplies the intended template explicitly. Its old
// gameplay values do not determine whether this authored build may be applied.
DEFINE_PATCH_FUNCTION cbm_fade_make_fighter_thief
  INT_VAR cbm_fade_thief_class = 0 cbm_fade_fighter_thief_class = 0
  STR_VAR cbm_fade_template = ~~
BEGIN
  PATCH_IF (SOURCE_SIZE < 0x2d4) BEGIN PATCH_FAIL ~cbm_fade_ft_fix: truncated CRE~ END
  READ_ASCII 0x00 cbm_fade_signature (8)
  READ_ASCII 0x280 cbm_fade_dv (32) NULL
  READ_LONG 0x18 cbm_fade_total_xp
  PATCH_IF NOT (~%cbm_fade_signature%~ STRING_EQUAL ~CRE V1.0~) BEGIN
    PATCH_FAIL ~cbm_fade_ft_fix: expected a CRE V1.0 resource~
  END
  PATCH_IF NOT (~%cbm_fade_dv%~ STRING_EQUAL_CASE ~E3FADE~) BEGIN
    PATCH_FAIL ~cbm_fade_ft_fix: expected death variable E3FADE~
  END
  PATCH_IF (cbm_fade_fighter_thief_class <= 0) OR (cbm_fade_fighter_thief_class > 255) BEGIN
    PATCH_FAIL ~cbm_fade_ft_fix: invalid class context~
  END
  SPRINT cbm_fade_template EVALUATE_BUFFER ~%cbm_fade_template%~
  PATCH_IF (~%cbm_fade_template%~ STRING_EQUAL_CASE ~E3FADE13~) BEGIN
    SET cbm_fade_target_hide = 70
    SET cbm_fade_target_locks = 70
    SET cbm_fade_target_move = 70
    SET cbm_fade_target_find = 80
    SET cbm_fade_target_two_weapon = 1
  END ELSE PATCH_IF (~%cbm_fade_template%~ STRING_EQUAL_CASE ~E3FADE25~) BEGIN
    SET cbm_fade_target_hide = 85
    SET cbm_fade_target_locks = 80
    SET cbm_fade_target_move = 80
    SET cbm_fade_target_find = 95
    SET cbm_fade_target_two_weapon = 3
  END ELSE BEGIN
    PATCH_FAIL ~cbm_fade_ft_fix: unsupported Fade template~
  END
  SET cbm_fade_class_xp = cbm_fade_total_xp / 2
  SET cbm_fade_fighter_level = 0
  SET cbm_fade_thief_level = 0
  FOR (cbm_fade_level = 1; cbm_fade_level <= 255; ++cbm_fade_level) BEGIN
    PATCH_IF VARIABLE_IS_SET $cbm_fade_fighter_xp(~%cbm_fade_level%~) BEGIN
      PATCH_IF ($cbm_fade_fighter_xp(~%cbm_fade_level%~) <= cbm_fade_class_xp) BEGIN
        SET cbm_fade_fighter_level = cbm_fade_level
      END
    END
    PATCH_IF VARIABLE_IS_SET $cbm_fade_thief_xp(~%cbm_fade_level%~) BEGIN
      PATCH_IF ($cbm_fade_thief_xp(~%cbm_fade_level%~) <= cbm_fade_class_xp) BEGIN
        SET cbm_fade_thief_level = cbm_fade_level
      END
    END
  END
  PATCH_IF (cbm_fade_fighter_level < 1) OR (cbm_fade_thief_level < 1) BEGIN
    PATCH_FAIL ~cbm_fade_ft_fix: installed XPLEVEL.2DA cannot derive Fade levels~
  END
  READ_BYTE 0x33 cbm_fade_effect_version
  READ_LONG 0x2c4 cbm_fade_effect_offset
  READ_LONG 0x2c8 cbm_fade_effect_count
  SET cbm_fade_effect_size = cbm_fade_effect_version = 1 ? 0x108 : 0x30
  PATCH_IF ((cbm_fade_effect_version > 1) OR (cbm_fade_effect_count < 0)
         OR (cbm_fade_effect_count > SOURCE_SIZE / cbm_fade_effect_size)
         OR ((cbm_fade_effect_count > 0) AND ((cbm_fade_effect_offset < 0x2d4)
           OR (cbm_fade_effect_offset > SOURCE_SIZE - cbm_fade_effect_count * cbm_fade_effect_size)))) BEGIN
    PATCH_FAIL ~cbm_fade_ft_fix: invalid embedded effect table~
  END
  LPF cbm_npc_clear_previous_kit INT_VAR target_kit = 0x40000000 END
  // A multiclass build has no inactive former class; preserve unrelated flags.
  WRITE_LONG 0x10 ((LONG_AT 0x10) BAND 0xfffffe07)
  WRITE_BYTE 0x273 cbm_fade_fighter_thief_class
  WRITE_LONG 0x244 0x40000000
  WRITE_BYTE 0x234 cbm_fade_fighter_level
  WRITE_BYTE 0x235 cbm_fade_thief_level
  WRITE_BYTE 0x236 0
  WRITE_BYTE 0x45 cbm_fade_target_hide
  WRITE_BYTE 0x67 cbm_fade_target_locks
  WRITE_BYTE 0x68 cbm_fade_target_move
  WRITE_BYTE 0x69 cbm_fade_target_find
  LPF cbm_npc_clear_proficiencies END
  SET_BG2_PROFICIENCY 91 2
  SET_BG2_PROFICIENCY 94 1
  SET_BG2_PROFICIENCY 96 1
  SET_BG2_PROFICIENCY 105 1
  SET_BG2_PROFICIENCY 114 cbm_fade_target_two_weapon
END

DEFINE_PATCH_FUNCTION cbm_fade_allow_fighter_thief BEGIN
  PATCH_IF (SOURCE_SIZE < 0x72) BEGIN
    PATCH_FAIL ~cbm_fade_ft_fix: truncated Fade amulet ITM~
  END
  READ_ASCII 0x00 cbm_fade_item_signature (8)
  PATCH_IF NOT (~%cbm_fade_item_signature%~ STRING_EQUAL ~ITM V1  ~) BEGIN
    PATCH_FAIL ~cbm_fade_ft_fix: expected an ITM V1 resource~
  END
  WRITE_BYTE 0x20 ((BYTE_AT 0x20) BAND 0xfd)
END
