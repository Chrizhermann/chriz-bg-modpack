INCLUDE ~chriz-bg-modpack/lib/cbm_join_xp_blocks.tpa~
// Each selected recruitment template gets the authored one-shot XP ladder.
// Story blocks remain in a private copy of its effective override script.
DEFINE_ACTION_FUNCTION cbm_recruitment_xp
  STR_VAR creature = ~~ private_script = ~~ companion = ~~ BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%creature%.CRE~ BEGIN
    OUTER_SET cbmr_writable = 0
    COPY_EXISTING - ~%creature%.CRE~ ~.../cbmr-cre~
      LPF cbmo_cre_writable RET cbmr_writable = cbmo_writable END
      PATCH_IF cbmr_writable BEGIN READ_ASCII 0x248 cbmr_script (8) NULL END
    ACTION_IF cbmr_writable BEGIN
      OUTER_SPRINT cbmr_prefix ~~
      ACTION_FOR_EACH cbmr_xp IN 1250000 1000000 750000 500000 250000 125000 BEGIN
        OUTER_SET cbmr_threshold = cbmr_xp - 1
        OUTER_SPRINT cbmr_prefix ~%cbmr_prefix%
IF
  Global("CBM_SoARecruitXP","LOCALS",0)
  InParty(Myself)
  XPGT(Player1,%cbmr_threshold%)
  XPLT(Myself,%cbmr_xp%)
THEN
  RESPONSE #100
    SetInterrupt(FALSE)
    SetGlobal("CBM_SoARecruitXP","LOCALS",1)
    ChangeStat(Myself,XP,%cbmr_xp%,SET)
    SetInterrupt(TRUE)
END
~
      END
      OUTER_SPRINT cbmr_prefix ~%cbmr_prefix%
IF
  Global("CBM_SoARecruitXP","LOCALS",0)
  InParty(Myself)
THEN
  RESPONSE #100
    SetGlobal("CBM_SoARecruitXP","LOCALS",1)
END
~

<<<<<<<< .../cbmr-prefix.baf
%cbmr_prefix%
>>>>>>>>
      COPY - ~.../cbmr-prefix.baf~ ~.../cbmr-evaluated.baf~ EVALUATE_BUFFER
      ACTION_IF FILE_EXISTS_IN_GAME ~%cbmr_script%.BCS~ BEGIN
        COPY_EXISTING - ~%cbmr_script%.BCS~ ~.../cbmr-source~
          // Remove our previous ladder before normalizing competing providers.
          INNER_ACTION BEGIN
            COPY - ~.../cbmr-evaluated.baf~ ~.../cbmr-compiled~
              COMPILE_BAF_TO_BCS
              DELETE_BYTES (BUFFER_LENGTH - 3) 3 DELETE_BYTES 0 3
              READ_ASCII 0 cbmr_owned (BUFFER_LENGTH)
          END
          REPLACE_TEXTUALLY ~%MNL%~ ~~
          REPLACE_TEXTUALLY CASE_SENSITIVE EXACT_MATCH ~%cbmr_owned%~ ~~
          DECOMPILE_BCS_TO_BAF
          LPF cbm_join_xp_takeover END
          COMPILE_BAF_TO_BCS
      END ELSE BEGIN
<<<<<<<< .../cbmr-source
SC
SC
>>>>>>>>
        PRINT ~%companion%: %cbmr_script%.BCS is absent; creating the recruitment script.~
      END
      COPY ~.../cbmr-source~ ~override/%private_script%.BCS~
        LPF cbmo_script_block STR_VAR replacement = ~.../cbmr-evaluated.baf~ marker = ~CBM_SoARecruitXP~ END
      COPY_EXISTING ~%creature%.CRE~ ~override~ WRITE_ASCIIE 0x248 ~%private_script%~ #8 BUT_ONLY
    END ELSE BEGIN PRINT ~%companion%: %creature%.CRE is too damaged to write.~ END
  END ELSE BEGIN PRINT ~%companion%: %creature%.CRE is absent.~ END
END
