// Own one droppable DAGG11 entry on each named Marek template. Another
// source of the item does not cancel the selected placement component.
ACTION_FOR_EACH cbm_mbd_cre IN ~MAREK~ ~MAREK1~ BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%cbm_mbd_cre%.CRE~ BEGIN
    COPY_EXISTING ~%cbm_mbd_cre%.CRE~ ~override~
      LPF cbmo_cre_writable RET cbmo_writable END
      PATCH_IF cbmo_writable BEGIN
        READ_LONG 0x2b8 cbmo_slots
        SET cbmo_writable = cbmo_slots >= 0x2d4 AND cbmo_slots <= BUFFER_LENGTH - 80
        PATCH_IF cbmo_writable BEGIN
          FOR (cbmm_slot = 0; cbmm_slot < 38; ++cbmm_slot) BEGIN
            READ_SHORT (cbmo_slots + cbmm_slot * 2) cbmm_index
            PATCH_IF cbmm_index != 0xffff AND cbmm_index >= LONG_AT 0x2c0 BEGIN SET cbmo_writable = 0 END
          END
        END
      END
      PATCH_IF cbmo_writable BEGIN
        READ_LONG 0x2bc cbmm_items
        READ_LONG 0x2c0 cbmm_count
        SET cbmm_first = 0 - 1
        FOR (cbmm_i = 0; cbmm_i < cbmm_count; ++cbmm_i) BEGIN
          READ_ASCII (cbmm_items + cbmm_i * 20) cbmm_name (8) NULL
          PATCH_IF ~%cbmm_name%~ STRING_EQUAL_CASE ~DAGG11~ AND cbmm_first < 0 BEGIN SET cbmm_first = cbmm_i END
        END
        PATCH_IF cbmm_first >= 0 BEGIN
          FOR (cbmm_i = cbmm_count - 1; cbmm_i > cbmm_first; --cbmm_i) BEGIN
            SET cbmm_at = cbmm_items + cbmm_i * 20
            READ_ASCII cbmm_at cbmm_name (8) NULL
            PATCH_IF ~%cbmm_name%~ STRING_EQUAL_CASE ~DAGG11~ BEGIN
              DELETE_BYTES cbmm_at 20
              PATCH_FOR_EACH cbmm_p IN 0x2a0 0x2a8 0x2b0 0x2b8 0x2c4 BEGIN
                PATCH_IF LONG_AT cbmm_p >= cbmm_at + 20 BEGIN WRITE_LONG cbmm_p (LONG_AT cbmm_p - 20) END
              END
              WRITE_LONG 0x2c0 (LONG_AT 0x2c0 - 1)
              READ_LONG 0x2b8 cbmo_slots
              FOR (cbmm_slot = 0; cbmm_slot < 38; ++cbmm_slot) BEGIN
                READ_SHORT (cbmo_slots + cbmm_slot * 2) cbmm_index
                PATCH_IF cbmm_index = cbmm_i BEGIN WRITE_SHORT (cbmo_slots + cbmm_slot * 2) 0xffff END
                ELSE PATCH_IF cbmm_index > cbmm_i AND cbmm_index < cbmm_count BEGIN WRITE_SHORT (cbmo_slots + cbmm_slot * 2) (cbmm_index - 1) END
              END
            END
          END
          SET cbmm_at = cbmm_items + cbmm_first * 20
          WRITE_ASCII cbmm_at ~DAGG11~ #8
          WRITE_SHORT (cbmm_at + 10) 0 WRITE_SHORT (cbmm_at + 12) 0 WRITE_SHORT (cbmm_at + 14) 0
          WRITE_LONG (cbmm_at + 16) 0
        END ELSE BEGIN
          // Additional unused equipment slots allow a full backpack to retain all items.
          ADD_CRE_ITEM ~DAGG11~ #0 #0 #0 ~NONE~ ~INV1 INV2 INV3 INV4 INV5 INV6 INV7 INV8 INV9 INV10 INV11 INV12 INV13 INV14 INV15 INV16 QITEM1 QITEM2 QITEM3 WEAPON4 WEAPON3 WEAPON2~
        END
        PATCH_PRINT @6707
      END ELSE BEGIN PATCH_PRINT ~Marek: %SOURCE_FILE% is too damaged to write.~ END
    BUT_ONLY
  END ELSE BEGIN PRINT @6708 END
END
PRINT @6709
