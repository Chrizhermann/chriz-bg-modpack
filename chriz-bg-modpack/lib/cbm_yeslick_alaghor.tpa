// This option owns only the kit field of the two BG1 recruitment templates.
// The installed kit provides its normal recruitment and level-up grants.
INCLUDE ~chriz-bg-modpack/lib/cbm_collection_defaults.tpa~
DEFINE_ACTION_FUNCTION cbmy_install BEGIN
  LAF cbm_collection_resolve_kit STR_VAR symbol = ~LK_ALAGHOR~ RET cbmy_kit = kit_dword END
  ACTION_FOR_EACH cbmy_cre IN YESLIC YESLIC5 BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%cbmy_cre%.CRE~ BEGIN
      COPY_EXISTING ~%cbmy_cre%.CRE~ ~override~
        LPF cbm_collection_set_npc_kit INT_VAR target_kit = cbmy_kit END
      BUT_ONLY
    END ELSE BEGIN PRINT ~Yeslick: %cbmy_cre%.CRE is absent.~ END
  END
END
