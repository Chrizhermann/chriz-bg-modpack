// Own the transformation link, preserving unrelated ability and casting effects.
OUTER_FOR (cbm_slayer_number = 2; cbm_slayer_number <= 4; ++cbm_slayer_number) BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~SLAYER%cbm_slayer_number%.SPL~ BEGIN
    COPY_EXISTING ~SLAYER%cbm_slayer_number%.SPL~ ~override~
      LPF cbmo_own_spell_effect INT_VAR opcode = 146
          STR_VAR match1 = EVAL ~FINSLAY%cbm_slayer_number%~
              match2 = EVAL ~SLAYER%cbm_slayer_number%A~
              resource = EVAL ~slayer%cbm_slayer_number%a~ END
      LPF cbmo_write_description END
    BUT_ONLY
  END ELSE BEGIN PRINT ~Ascension: SLAYER%cbm_slayer_number%.SPL is absent.~ END
END
PRINT ~[cbm_ascension_slayer_eefp_fix] repaired the three upgraded Slayer transformation links.~
