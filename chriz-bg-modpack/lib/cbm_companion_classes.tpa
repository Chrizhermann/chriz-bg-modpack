// Companion conversions for BG2EE/EET. See docs/companion-classes.md for
// provenance, installation order and the deliberately preserved NPC XP gap.

DEFINE_ACTION_FUNCTION cbm_npc_table STR_VAR table = ~~
  RET_ARRAY cbm_cell cbm_column cbm_cols BEGIN
  LAF cbmo_read_table STR_VAR table RET_ARRAY cbmo_cell cbmo_column cbmo_cols END
  ACTION_PHP_EACH cbmo_cell AS keys => value BEGIN OUTER_SPRINT $cbm_cell(~%keys_0%~ ~%keys_1%~ ~%keys_2%~) ~%value%~ END
  ACTION_PHP_EACH cbmo_column AS keys => value BEGIN OUTER_SET $cbm_column(~%keys_0%~ ~%keys_1%~) = value END
  ACTION_PHP_EACH cbmo_cols AS key => value BEGIN OUTER_SET $cbm_cols(~%key%~) = value END
END

DEFINE_PATCH_FUNCTION cbm_npc_level INT_VAR xp = 0 STR_VAR class = ~~ RET level BEGIN
  SET level = 1
  FOR (n = 2; n < $cbm_cols(~XPLEVEL~); ++n) BEGIN
    SET threshold = $cbm_cell(~XPLEVEL~ ~%class%~ ~%n%~)
    PATCH_IF (threshold >= 0 AND xp >= threshold) BEGIN SET level = n END
  END
END

DEFINE_PATCH_FUNCTION cbm_npc_number
  INT_VAR fallback = 0 STR_VAR table = ~~ row = ~~ column = ~~ RET number BEGIN
  SET number = fallback
  TO_UPPER table
  PATCH_IF VARIABLE_IS_SET $cbm_column(~%table%~ ~%column%~) BEGIN
    SET hp_column = $cbm_column(~%table%~ ~%column%~)
    PATCH_IF VARIABLE_IS_SET $cbm_cell(~%table%~ ~%row%~ ~%hp_column%~) BEGIN
      SPRINT hp_value $cbm_cell(~%table%~ ~%row%~ ~%hp_column%~)
      PATCH_IF IS_AN_INT ~%hp_value%~ BEGIN SET number = hp_value END
    END
  END
END

DEFINE_PATCH_FUNCTION cbm_npc_hp INT_VAR level = 1 STR_VAR table = ~~ baseline = ~HPROG~ RET hp BEGIN
  // Half-hit-point units retain the expected value of odd-sided averages.
  // Preserve the original creature's roll quality by scaling its existing HP.
  SET hp = 0
  FOR (n = 1; n <= level; ++n) BEGIN
    SET cbm_hp_row = n > 50 ? 50 : n
    LPF cbm_npc_number STR_VAR table = EVAL ~%baseline%~ row = EVAL ~%cbm_hp_row%~ column = ~SIDES~ RET sides = number END
    LPF cbm_npc_number STR_VAR table = EVAL ~%baseline%~ row = EVAL ~%cbm_hp_row%~ column = ~ROLLS~ RET rolls = number END
    LPF cbm_npc_number STR_VAR table = EVAL ~%baseline%~ row = EVAL ~%cbm_hp_row%~ column = ~MODIFIER~ RET modifier = number END
    LPF cbm_npc_number INT_VAR fallback = sides STR_VAR table = EVAL ~%table%~ row = EVAL ~%n%~ column = ~SIDES~ RET sides = number END
    LPF cbm_npc_number INT_VAR fallback = rolls STR_VAR table = EVAL ~%table%~ row = EVAL ~%n%~ column = ~ROLLS~ RET rolls = number END
    LPF cbm_npc_number INT_VAR fallback = modifier STR_VAR table = EVAL ~%table%~ row = EVAL ~%n%~ column = ~MODIFIER~ RET modifier = number END
    SET hp += modifier * 2 + rolls * (n = 1 ? sides * 2 : sides + 1)
  END
END

DEFINE_PATCH_FUNCTION cbm_npc_clear_clab STR_VAR clab = ~~ BEGIN
  PATCH_IF (FILE_EXISTS_IN_GAME ~%clab%.2da~) BEGIN
    INNER_ACTION BEGIN
      COPY_EXISTING ~%clab%.2da~ ~override~
        COUNT_2DA_COLS cols
        COUNT_2DA_ROWS cols rows
        CLEAR_ARRAY cbm_clab_spells
        FOR (row = 0; row < rows; ++row) BEGIN
          FOR (col = 1; col < cols; ++col) BEGIN
            READ_2DA_ENTRY row col cols ability
            PATCH_IF (~%ability%~ STRING_MATCHES_REGEXP ~^AP_~ = 0 OR
                      ~%ability%~ STRING_MATCHES_REGEXP ~^GA_~ = 0) BEGIN
              INNER_PATCH ~%ability%~ BEGIN
                DELETE_BYTES 0 3
                READ_ASCII 0 spell (BUFFER_LENGTH)
              END
              SET $cbm_clab_spells(~%spell%~) = 1
            END
          END
        END
      BUT_ONLY
    END
    PHP_EACH cbm_clab_spells AS spell => unused BEGIN
      REMOVE_KNOWN_SPELL ~%spell%~
      REMOVE_MEMORIZED_SPELL ~%spell%~
      // DELETE_EFFECT's match_resource is the payload, not the parent spell.
      // Remove only EFF V2 records explicitly sourced from this old CLAB spell.
      PATCH_IF BYTE_AT 0x33 = 1 BEGIN
        READ_LONG 0x2c4 effects
        READ_LONG 0x2c8 effect_count
        FOR (fx = effect_count - 1; fx >= 0; --fx) BEGIN
          SET at = effects + fx * 0x108
          READ_ASCII (at + 0x8c) source (8) NULL
          PATCH_IF (LONG_AT (at + 0x88) = 1 AND ~%source%~ STRING_EQUAL_CASE ~%spell%~) BEGIN
            DELETE_BYTES at 0x108
            WRITE_LONG 0x2c8 (LONG_AT 0x2c8 - 1)
            PATCH_FOR_EACH pointer IN 0x2a0 0x2a8 0x2b0 0x2b8 0x2bc BEGIN
              PATCH_IF LONG_AT pointer > at BEGIN WRITE_LONG pointer (LONG_AT pointer - 0x108) END
            END
          END
        END
      END
    END
  END
END

DEFINE_PATCH_FUNCTION cbm_npc_skills INT_VAR level = 1 vampire = 0
  STR_VAR kit = ~~ BEGIN
  SPRINT skill_row ~%kit%~
  PATCH_IF NOT VARIABLE_IS_SET $cbm_cell(~THIEFSKL~ ~%skill_row%~ ~1~) BEGIN
    SPRINT skill_row ~THIEF~
  END
  SET budget = $cbm_cell(~THIEFSKL~ ~%skill_row%~ ~1~) +
               (level - 1) * $cbm_cell(~THIEFSKL~ ~%skill_row%~ ~2~)
  SET skill_col = $cbm_column(~THIEFSCL~ ~%kit%~)
  CLEAR_ARRAY cbm_weight
  CLEAR_ARRAY cbm_value
  SET weight_sum = 0
  PHP_EACH cbm_skill_offset AS skill => offset BEGIN
    SET base = vampire * $cbm_human(~%skill%~)
    SET enabled = $cbm_cell(~THIEFSCL~ ~%skill%~ ~%skill_col%~)
    SET $cbm_value(~%skill%~) = enabled > 0 ? base : 0
    SET weight = BYTE_AT offset - base
    SET weight = enabled > 0 ? (weight > 1 ? weight : 1) : 0
    SET $cbm_weight(~%skill%~) = weight
    SET weight_sum += weight
  END
  PATCH_IF (budget < 0 OR weight_sum = 0) BEGIN
    SET budget = budget < 0 ? 0 : budget
    SET weight_sum = weight_sum = 0 ? 1 : weight_sum
  END
  SET left = budget
  PHP_EACH cbm_skill_offset AS skill => offset BEGIN
    SET allocation = (budget * $cbm_weight(~%skill%~)) / weight_sum
    SET room = 255 - $cbm_value(~%skill%~)
    SET allocation = allocation < room ? allocation : room
    SET $cbm_value(~%skill%~) += allocation
    SET left -= allocation
  END
  // Deterministic remainder distribution, including any points above one cap.
  WHILE (left > 0) BEGIN
    SET before = left
    PHP_EACH cbm_skill_offset AS skill => offset BEGIN
      PATCH_IF (left > 0 AND $cbm_weight(~%skill%~) > 0 AND
                $cbm_value(~%skill%~) < 255) BEGIN
        SET $cbm_value(~%skill%~) += 1
        SET left -= 1
      END
    END
    PATCH_IF (before = left) BEGIN
      SET left = 0
    END
  END
  PHP_EACH cbm_skill_offset AS skill => offset BEGIN
    WRITE_BYTE offset $cbm_value(~%skill%~)
  END
END

DEFINE_PATCH_FUNCTION cbm_npc_fighter_thief BEGIN
  READ_LONG 0x18 total_xp
  READ_BYTE 0x234 old_level
  SET old_level = old_level < 1 ? 1 : (old_level > 50 ? 50 : old_level)
  READ_BYTE 0x235 old_thief
  SET old_thief = old_thief < 1 ? 1 : (old_thief > 50 ? 50 : old_thief)
  SET source_multi = BYTE_AT 0x273 = 9
  SET represented_xp = total_xp
  SET next = old_level + 1
  PATCH_IF (next < $cbm_cols(~XPLEVEL~)) BEGIN
    SET ceiling = $cbm_cell(~XPLEVEL~ ~THIEF~ ~%next%~)
    PATCH_IF (ceiling > 0 AND represented_xp >= ceiling) BEGIN SET represented_xp = ceiling - 1 END
  END
  PATCH_IF source_multi BEGIN
    SET represented_xp = total_xp
    SET next = old_level + 1
    PATCH_IF next < $cbm_cols(~XPLEVEL~) BEGIN
      SET ceiling = 2 * $cbm_cell(~XPLEVEL~ ~FIGHTER~ ~%next%~)
      PATCH_IF ceiling > 0 AND represented_xp >= ceiling BEGIN SET represented_xp = ceiling - 1 END
    END
    SET next = old_thief + 1
    PATCH_IF next < $cbm_cols(~XPLEVEL~) BEGIN
      SET ceiling = 2 * $cbm_cell(~XPLEVEL~ ~THIEF~ ~%next%~)
      PATCH_IF ceiling > 0 AND represented_xp >= ceiling BEGIN SET represented_xp = ceiling - 1 END
    END
  END
  LPF cbm_npc_level INT_VAR xp = represented_xp / 2 STR_VAR class = ~FIGHTER~ RET fighter = level END
  LPF cbm_npc_level INT_VAR xp = represented_xp / 2 STR_VAR class = ~THIEF~ RET thief = level END
  WRITE_BYTE 0x273 9
  WRITE_BYTE 0x234 fighter
  WRITE_BYTE 0x235 thief
  WRITE_BYTE 0x236 0
  WRITE_LONG 0x244 0x40000000
  // Rebuild base progression, retaining individual NPC bonuses/penalties.
  SET old_thac0 = $cbm_cell(~THAC0~ ~THIEF~ ~%old_level%~)
  PATCH_IF source_multi BEGIN
    SET old_thac0 = $cbm_cell(~THAC0~ ~FIGHTER~ ~%old_level%~)
    SET old_thief_thac0 = $cbm_cell(~THAC0~ ~THIEF~ ~%old_thief%~)
    SET old_thac0 = old_thac0 < old_thief_thac0 ? old_thac0 : old_thief_thac0
  END
  SET fighter_thac0 = $cbm_cell(~THAC0~ ~FIGHTER~ ~%fighter%~)
  SET thief_thac0 = $cbm_cell(~THAC0~ ~THIEF~ ~%thief%~)
  SET new_thac0 = fighter_thac0 < thief_thac0 ? fighter_thac0 : thief_thac0
  READ_SBYTE 0x52 current_thac0
  SET result = current_thac0 + new_thac0 - old_thac0
  WRITE_BYTE 0x52 (result < (0 - 128) ? (0 - 128) : (result > 127 ? 127 : result))
  FOR (save = 0; save < 5; ++save) BEGIN
    SPRINT row $cbm_save_row(~%save%~)
    SET old_save = $cbm_cell(~SAVEROG~ ~%row%~ ~%old_level%~)
    PATCH_IF source_multi BEGIN
      SET old_save = $cbm_cell(~SAVEWAR~ ~%row%~ ~%old_level%~)
      SET old_thief_save = $cbm_cell(~SAVEROG~ ~%row%~ ~%old_thief%~)
      SET old_save = old_save < old_thief_save ? old_save : old_thief_save
    END
    SET fighter_save = $cbm_cell(~SAVEWAR~ ~%row%~ ~%fighter%~)
    SET thief_save = $cbm_cell(~SAVEROG~ ~%row%~ ~%thief%~)
    SET new_save = fighter_save < thief_save ? fighter_save : thief_save
    READ_SBYTE (0x54 + save) current_save
    SET result = current_save + new_save - old_save
    WRITE_BYTE (0x54 + save) (result < (0 - 128) ? (0 - 128) : (result > 127 ? 127 : result))
  END
  SET old_lore = old_level * $cbm_cell(~LORE~ ~THIEF~ ~1~)
  PATCH_IF source_multi BEGIN
    SET old_lore = old_level * $cbm_cell(~LORE~ ~FIGHTER~ ~1~)
    SET old_thief_lore = old_thief * $cbm_cell(~LORE~ ~THIEF~ ~1~)
    SET old_lore = old_lore > old_thief_lore ? old_lore : old_thief_lore
  END
  SET fighter_lore = fighter * $cbm_cell(~LORE~ ~FIGHTER~ ~1~)
  SET thief_lore = thief * $cbm_cell(~LORE~ ~THIEF~ ~1~)
  SET new_lore = fighter_lore > thief_lore ? fighter_lore : thief_lore
  SET result = BYTE_AT 0x66 + new_lore - old_lore
  WRITE_BYTE 0x66 (result < 0 ? 0 : (result > 255 ? 255 : result))
  SPRINT rogue_hp $cbm_cell(~HPCLASS~ ~THIEF~ ~1~)
  SPRINT warrior_hp $cbm_cell(~HPCLASS~ ~FIGHTER~ ~1~)
  LPF cbm_npc_hp INT_VAR level = old_level STR_VAR table = EVAL ~%rogue_hp%~ RET old_hp = hp END
  LPF cbm_npc_hp INT_VAR level = fighter STR_VAR table = EVAL ~%warrior_hp%~ baseline = ~HPWAR~ RET fighter_hp = hp END
  LPF cbm_npc_hp INT_VAR level = thief STR_VAR table = EVAL ~%rogue_hp%~ RET thief_hp = hp END
  SET old_hp = old_hp * 2
  PATCH_IF source_multi BEGIN
    LPF cbm_npc_hp INT_VAR level = old_level STR_VAR table = EVAL ~%warrior_hp%~ baseline = ~HPWAR~ RET old_fighter_hp = hp END
    LPF cbm_npc_hp INT_VAR level = old_thief STR_VAR table = EVAL ~%rogue_hp%~ RET old_thief_hp = hp END
    SET old_hp = old_fighter_hp + old_thief_hp
  END
  SET old_hp = old_hp > 0 ? old_hp : 1
  READ_SHORT 0x24 current_hp
  READ_SHORT 0x26 maximum_hp
  SET new_hp = (maximum_hp * (fighter_hp + thief_hp) + old_hp / 2) / old_hp
  SET new_hp = new_hp > 0 ? new_hp : 1
  WRITE_SHORT 0x24 (maximum_hp > 0 ? (current_hp * new_hp / maximum_hp) : new_hp)
  WRITE_SHORT 0x26 new_hp
  LPF cbm_npc_skills INT_VAR level = thief vampire = 1 STR_VAR kit = ~FIGHTER_THIEF~ END

  // The selected Fighter/Thief preset owns the complete weapon/style allocation.
  // Spend its installed-table budget in the authored order below, independently
  // of any earlier mod's pips. Clear only standard proficiency effects.
  SET prof_col = $cbm_column(~WEAPPROF~ ~FIGHTER_THIEF~)
  SET cbm_prof_interval = $cbm_cell(~PROFS~ ~FIGHTER_THIEF~ ~2~)
  SET cbm_prof_interval = cbm_prof_interval > 0 ? cbm_prof_interval : 3
  SET prof_budget = $cbm_cell(~PROFS~ ~FIGHTER_THIEF~ ~1~) + fighter / cbm_prof_interval
  CLEAR_ARRAY cbm_profs
  FOR (stat = 89; stat <= 115; ++stat) BEGIN
    SET $cbm_profs(~%stat%~) = 0
  END
  LPF cbm_npc_clear_proficiencies END
  WHILE (prof_budget > 0) BEGIN
    SET before = prof_budget
    PATCH_FOR_EACH row IN ~LONGSWORD~ ~DAGGER~ ~SINGLEWEAPON~ ~CLUB~ ~2WEAPON~ BEGIN
      SET stat = $cbm_prof_stat(~%row%~)
      PATCH_IF (prof_budget > 0 AND $cbm_profs(~%stat%~) < $cbm_cell(~WEAPPROF~ ~%row%~ ~%prof_col%~)) BEGIN
        SET $cbm_profs(~%stat%~) += 1
        SET_BG2_PROFICIENCY stat $cbm_profs(~%stat%~)
        SET prof_budget -= 1
      END
    END
    PATCH_IF before = prof_budget BEGIN
      SET prof_budget = 0
    END
  END
END

DEFINE_ACTION_FUNCTION cbm_companion_class STR_VAR npc = ~~ kit = ~~ BEGIN
  ACTION_DEFINE_ASSOCIATIVE_ARRAY cbm_skill_offset BEGIN
    PICK_POCKETS => 0x6a OPEN_LOCKS => 0x67 FIND_TRAPS => 0x69
    MOVE_SILENTLY => 0x68 HIDE_IN_SHADOWS => 0x45 DETECT_ILLUSION => 0x64 SET_TRAPS => 0x65
  END
  ACTION_DEFINE_ASSOCIATIVE_ARRAY cbm_human BEGIN
    PICK_POCKETS => 15 OPEN_LOCKS => 10 FIND_TRAPS => 5
    MOVE_SILENTLY => 10 HIDE_IN_SHADOWS => 5 DETECT_ILLUSION => 0 SET_TRAPS => 0
  END
  ACTION_DEFINE_ASSOCIATIVE_ARRAY cbm_save_row BEGIN
    0 => ~DEATH~ 1 => ~WANDS~ 2 => ~POLY~ 3 => ~BREATH~ 4 => ~SPELL~
  END
  ACTION_DEFINE_ASSOCIATIVE_ARRAY cbm_prof_stat BEGIN
    BASTARDSWORD => 89 LONGSWORD => 90 SHORTSWORD => 91 AXE => 92
    TWOHANDEDSWORD => 93 KATANA => 94 SCIMITARWAKISASHININJATO => 95
    DAGGER => 96 WARHAMMER => 97 SPEAR => 98 HALBERD => 99
    FLAILMORNINGSTAR => 100 MACE => 101 QUARTERSTAFF => 102 CROSSBOW => 103
    LONGBOW => 104 SHORTBOW => 105 DART => 106 SLING => 107
    ~2HANDED~ => 111 ~SWORDANDSHIELD~ => 112 ~SINGLEWEAPON~ => 113 ~2WEAPON~ => 114 ~CLUB~ => 115
  END
  ACTION_CLEAR_ARRAY cbm_cell
  ACTION_CLEAR_ARRAY cbm_column
  ACTION_FOR_EACH table IN ~KITLIST~ ~THIEFSKL~ ~THIEFSCL~ BEGIN
    LAF cbm_npc_table STR_VAR table RET_ARRAY cbm_cell cbm_column cbm_cols END
  END
  OUTER_SET target_kit = 0x4000
  ACTION_IF ~%kit%~ STRING_EQUAL_CASE ~FIGHTER_THIEF~ BEGIN
    ACTION_FOR_EACH table IN ~XPLEVEL~ ~THAC0~ ~SAVEROG~ ~SAVEWAR~ ~LORE~ ~HPCLASS~ ~PROFS~ ~WEAPPROF~ ~HPROG~ ~HPWAR~ BEGIN
      LAF cbm_npc_table STR_VAR table RET_ARRAY cbm_cell cbm_column cbm_cols END
    END
    OUTER_SPRINT table $cbm_cell(~HPCLASS~ ~THIEF~ ~1~)
    LAF cbm_npc_table STR_VAR table RET_ARRAY cbm_cell cbm_column cbm_cols END
    OUTER_SPRINT table $cbm_cell(~HPCLASS~ ~FIGHTER~ ~1~)
    LAF cbm_npc_table STR_VAR table RET_ARRAY cbm_cell cbm_column cbm_cols END
  END ELSE BEGIN
    OUTER_SET target_kit = FILE_EXISTS_IN_GAME ~KIT.IDS~ ? IDS_OF_SYMBOL (~KIT~ ~%kit%~) : (0 - 1)
    ACTION_IF target_kit < 0 BEGIN
      INCLUDE ~chriz-bg-modpack/lib/cbm_collection_defaults.tpa~
      LAF cbm_collection_resolve_kit STR_VAR symbol = EVAL ~%kit%~ RET kit_dword END
      OUTER_SET target_kit = (kit_dword BLSR 16) BAND 0xffff
    END
  END
  ACTION_IF ~%npc%~ STRING_EQUAL_CASE ~YOSHIMO~ BEGIN
    ACTION_DEFINE_ARRAY cbm_creatures BEGIN ~YOSHI7~ ~YOSHI8~ ~YOSHI10~ ~YOSHI11~ ~YOSHI12~ END
  END ELSE BEGIN
    ACTION_DEFINE_ARRAY cbm_creatures BEGIN ~OHHEX8~ ~OHHEX9~ ~OHHEX10~ ~OHHEX11~ ~OHHEX13~ ~OHHEX15~ ~OHHEX25~ END
  END
  OUTER_SET count = 0
  ACTION_PHP_EACH cbm_creatures AS index => creature BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%creature%.cre~ BEGIN
      COPY_EXISTING ~%creature%.cre~ ~override~
        LPF cbmo_cre_writable RET cbmo_writable END
        PATCH_IF cbmo_writable BEGIN
        READ_LONG 0x244 old_kit
        SET old_kit = ((old_kit BAND 0xffff) BLSL 16) BOR ((old_kit BLSR 16) BAND 0xffff)
        LPF cbm_npc_clear_clab STR_VAR clab = ~CLABTH01~ END
        // KITLIST is keyed by row number, while its KITIDS cell is the value
        // encoded in the CRE. These are intentionally not assumed identical.
        PHP_EACH cbm_cell AS keys => value BEGIN
          PATCH_IF (~%keys_0%~ STRING_EQUAL_CASE ~KITLIST~ AND ~%keys_2%~ STRING_EQUAL_CASE ~9~) BEGIN
            PATCH_IF (IS_AN_INT ~%value%~ AND value = old_kit) BEGIN
              SPRINT old_clab $cbm_cell(~KITLIST~ ~%keys_1%~ ~5~)
              LPF cbm_npc_clear_clab STR_VAR clab = EVAL ~%old_clab%~ END
            END
          END
        END
        PATCH_IF ~%kit%~ STRING_EQUAL_CASE ~FIGHTER_THIEF~ BEGIN
          LPF cbm_npc_fighter_thief END
        END ELSE BEGIN
          WRITE_BYTE 0x273 4
          WRITE_LONG 0x244 (((target_kit BAND 0xffff) BLSL 16) BOR ((target_kit BLSR 16) BAND 0xffff))
          LPF cbm_npc_skills INT_VAR level = BYTE_AT 0x234
              vampire = ~%npc%~ STRING_EQUAL_CASE ~HEXXAT~ STR_VAR kit END
        END
        SET count += 1
        END ELSE BEGIN PATCH_PRINT ~Companion conversion: %SOURCE_FILE% is too damaged to write.~ END
      BUT_ONLY
    END ELSE BEGIN PRINT ~Companion conversion: %creature%.CRE is absent.~ END
  END
  ACTION_IF count = 0 BEGIN PRINT ~Companion conversion: no supported companion CREs were found.~ END

  ACTION_IF ~%npc%~ STRING_EQUAL_CASE ~YOSHIMO~ AND FILE_EXISTS_IN_GAME ~NPSW02.ITM~ BEGIN
    COPY_EXISTING ~NPSW02.ITM~ ~override~
      PATCH_IF SOURCE_SIZE >= 0x72 BEGIN
        WRITE_BYTE 0x2b (BYTE_AT 0x2b BAND 0xef)
        LPF cbmo_write_description END
      END ELSE BEGIN PATCH_PRINT ~Companion conversion: %SOURCE_FILE% is too damaged to write.~ END
    BUT_ONLY
  END
  ACTION_IF ~%kit%~ STRING_EQUAL_CASE ~FIGHTER_THIEF~ BEGIN
    OUTER_SET domination_1 = $cbm_cell(~XPLEVEL~ ~THIEF~ ~14~) - 1
    OUTER_SET domination_2 = $cbm_cell(~XPLEVEL~ ~THIEF~ ~24~) - 1
<<<<<<<< .../cbmo-domination-old.baf
IF
  Global("ohh_dom","LOCALS",0)
  LevelGT(Myself,13)
THEN
  RESPONSE #100
    AddSpecialAbility("SPIN883")
    SetGlobal("ohh_dom","LOCALS",1)
END
IF
  Global("ohh_dom","LOCALS",1)
  LevelGT(Myself,23)
THEN
  RESPONSE #100
    AddSpecialAbility("SPIN883")
    SetGlobal("ohh_dom","LOCALS",2)
END
>>>>>>>>
    COPY - ~.../cbmo-domination-old.baf~ ~.../cbmo-domination-new.baf~
      REPLACE_TEXTUALLY EXACT_MATCH ~LevelGT(Myself,13)~ ~XPGT(Myself,%domination_1%)~
      REPLACE_TEXTUALLY EXACT_MATCH ~LevelGT(Myself,23)~ ~XPGT(Myself,%domination_2%)~
    ACTION_FOR_EACH script IN ~HEXXAT~ ~HEXXA25~ BEGIN
      ACTION_IF FILE_EXISTS_IN_GAME ~%script%.BCS~ BEGIN
        COPY_EXISTING ~%script%.BCS~ ~override~
          LPF cbmo_script_block STR_VAR original = ~.../cbmo-domination-old.baf~
              replacement = ~.../cbmo-domination-new.baf~ marker = ~ohh_dom~ END
        BUT_ONLY
      END ELSE BEGIN PRINT ~Companion conversion: %script%.BCS is absent.~ END
    END
  END
  PRINT @1195
END
