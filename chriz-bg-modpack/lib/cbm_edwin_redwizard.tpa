// The selected Red Wizard conversion owns every named Edwin template.
// Adapted from the resource-tested October 3 repair; no saved actors are edited.
DEFINE_PATCH_FUNCTION cbm_edwin_item BEGIN
  LPF cbmo_spell_layout RET cbmo_writable END
  PATCH_IF cbmo_writable BEGIN
  READ_ASCII 0 signature (8)
  READ_LONG 0x18 flags
  WRITE_LONG 0x18 ((flags BOR 4) BAND (BNOT 16))
  READ_LONG 0x6a fx_base
  READ_SHORT 0x6e fx_first
  READ_SHORT 0x70 fx_count
  SET fx_count = (fx_base < 0x72 OR fx_base > BUFFER_LENGTH) ? 0 : (fx_count > (BUFFER_LENGTH - fx_base) / 48 - fx_first ? (BUFFER_LENGTH - fx_base) / 48 - fx_first : fx_count)
  FOR (i = 0; i < fx_count; ++i) BEGIN
    SET pos = fx_base + (fx_first + i) * 48
    PATCH_IF SHORT_AT pos = 42 BEGIN
      WRITE_SHORT pos 0
      WRITE_LONG (pos + 4) 0
      WRITE_LONG (pos + 8) 0
      WRITE_BYTE (pos + 12) 0
      WRITE_LONG (pos + 14) 0
    END
  END
  LPF cbmo_write_description END
  END ELSE BEGIN
    PATCH_PRINT ~CBM: %SOURCE_FILE% is too damaged to write; leaving this resource alone.~
  END
END

DEFINE_PATCH_FUNCTION cbm_edwin_cre
  INT_VAR redwizard_id = 0 repair_missing_kit = 0
BEGIN
  LPF cbmo_cre_writable RET cbmo_writable END
  PATCH_IF cbmo_writable BEGIN
  READ_ASCII 0 signature (8)
  READ_ASCII 0x280 dv (32) NULL
  READ_LONG 0x244 encoded_kit
  SET current_kit = ((encoded_kit BAND 0xffff) BLSL 16)
                  BOR ((encoded_kit BLSR 16) BAND 0xffff)
  // The EET recruitment template also owns its converted spellbook cleanup.
  SET converted = repair_missing_kit
  WRITE_LONG 0x244 ((redwizard_id BAND 0xffff) BLSL 16)
  PATCH_IF converted BEGIN
    WRITE_LONG 0x244 ((redwizard_id BAND 0xffff) BLSL 16)
    SET current_kit = redwizard_id
  END
  PATCH_IF 1 BEGIN
    READ_BYTE 0x33 fx_version
    READ_LONG 0x2c4 fx_base
    READ_LONG 0x2c8 fx_count
    SET stride = fx_version = 0 ? 48 : 264
    FOR (i = 0; i < fx_count; ++i) BEGIN
      SET pos = fx_base + i * stride
      SET owned = 1
      PATCH_IF fx_version = 0 BEGIN
        READ_SHORT pos opcode
        READ_LONG (pos + 4) p1
        READ_LONG (pos + 8) p2
        READ_BYTE (pos + 12) timing
      END ELSE BEGIN
        READ_LONG (pos + 8) opcode
        READ_LONG (pos + 20) p1
        READ_LONG (pos + 24) p2
        READ_LONG (pos + 28) timing
        READ_LONG (pos + 0x88) parent_type
        READ_ASCII (pos + 0x8c) parent (8) NULL
        SET owned = (parent_type = 0) AND (~%parent%~ STRING_EQUAL ~~)
      END
      // Own source-less spell-slot grants. Retain grants attributed to other kits/items.
      PATCH_IF (opcode = 42) AND owned BEGIN
        PATCH_IF fx_version = 0 BEGIN
          WRITE_SHORT pos 0
          WRITE_LONG (pos + 4) 0
          WRITE_LONG (pos + 8) 0
          WRITE_BYTE (pos + 12) 0
          WRITE_LONG (pos + 14) 0
        END ELSE BEGIN
          WRITE_LONG (pos + 8) 0
          WRITE_LONG (pos + 20) 0
          WRITE_LONG (pos + 24) 0
          WRITE_LONG (pos + 28) 0
          WRITE_LONG (pos + 36) 0
        END
      END
    END
    READ_LONG 0x2bc item_base
    READ_LONG 0x2c0 item_count
    FOR (i = 0; i < item_count; ++i) BEGIN
      SET pos = item_base + i * 20
      READ_ASCII pos item (8) NULL
      PATCH_IF (~%item%~ STRING_EQUAL_CASE ~MISC89~)
          OR (~%item%~ STRING_EQUAL_CASE ~MISC89_~) BEGIN
        WRITE_LONG (pos + 16) (LONG_AT (pos + 16) BAND (BNOT 8))
      END
    END
    PATCH_IF converted BEGIN
      // Match the selected Artisan conversion at the same install-order stage.
      // Install this component before SR's final NPC spellbook pass (60).
      REMOVE_KNOWN_SPELL ~SPWI120~ ~SPWI106~ ~SPWI212~ ~SPWI201~ ~SPWI307~ ~SPWI405~ ~SPWI505~
      REMOVE_MEMORIZED_SPELL ~SPWI120~ ~SPWI106~ ~SPWI212~ ~SPWI201~ ~SPWI307~ ~SPWI405~ ~SPWI505~
    END
  END
  END ELSE BEGIN
    PATCH_PRINT ~CBM: %SOURCE_FILE% is too damaged to write; leaving this resource alone.~
  END
END

DEFINE_PATCH_FUNCTION cbm_edwin_write_grant BEGIN
  DELETE_BYTES 0 BUFFER_LENGTH
  INSERT_BYTES 0 0x24a
  WRITE_ASCII 0 ~SPL V1  ~ #8
  WRITE_LONG 0x08 0xffffffff
  WRITE_LONG 0x0c 0xffffffff
  WRITE_SHORT 0x1c 4
  WRITE_LONG 0x38 1
  WRITE_LONG 0x50 0xffffffff
  WRITE_LONG 0x54 0xffffffff
  WRITE_LONG 0x64 0x72
  WRITE_SHORT 0x68 1
  WRITE_LONG 0x6a 0x9a
  WRITE_SHORT 0x72 1
  WRITE_SHORT 0x74 4
  WRITE_BYTE 0x7e 1
  WRITE_BYTE 0x7f 0
  WRITE_SHORT 0x80 1
  WRITE_SHORT 0x82 1
  WRITE_SHORT 0x88 6
  WRITE_SHORT 0x8e 1
  WRITE_SHORT 0x90 9
  WRITE_SHORT 0x94 1
  WRITE_SHORT 0x96 1
  WRITE_SHORT 0x98 1
  FOR (i = 0; i < 9; ++i) BEGIN
    SET pos = 0x9a + i * 48
    WRITE_SHORT pos 42
    WRITE_BYTE (pos + 2) 1
    WRITE_LONG (pos + 4) 1
    WRITE_LONG (pos + 8) (1 BLSL i)
    WRITE_BYTE (pos + 12) 9
    WRITE_BYTE (pos + 18) 100
  END
END

DEFINE_ACTION_FUNCTION cbm_edwin_install BEGIN
  OUTER_SET redwizard_id = IDS_OF_SYMBOL (~KIT~ ~C0REDWIZ~)
  CREATE SPL ~cbmedsl~
  COPY_EXISTING ~CBMEDSL.SPL~ ~override~ LPF cbm_edwin_write_grant END
  COPY_EXISTING ~C0REDWIZ.2DA~ ~override~
    // Own the extra-slot grant, including earlier versions of that grant.
    REPLACE_TEXTUALLY ~AP_CBMEDSL~ ~****~
    REPLACE_TEXTUALLY ~AP_C0REDW4~ ~****~
    REPLACE_TEXTUALLY ~^CBMEDSLOT[^%LNL%%MNL%]*[%LNL%%MNL%]*~ ~~
    COUNT_2DA_COLS columns
    SPRINT grant_row ~CBMEDSLOT AP_CBMEDSL~
    FOR (i = 2; i < columns; ++i) BEGIN SPRINT grant_row ~%grant_row% ****~ END
    REPLACE_TEXTUALLY ~[%LNL%%MNL%]+$~ ~~
    SPRINT grant_row ~%WNL%%grant_row%%WNL%~
    SET append_at = BUFFER_LENGTH
    INSERT_BYTES append_at (STRING_LENGTH ~%grant_row%~)
    WRITE_ASCIIE append_at ~%grant_row%~
  BUT_ONLY
  ACTION_FOR_EACH item IN ~MISC89.ITM~ ~MISC89_.ITM~ BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%item%~ BEGIN
      COPY_EXISTING ~%item%~ ~override~ LPF cbm_edwin_item END BUT_ONLY
    END
  END
  ACTION_FOR_EACH creature IN
    ~EDWIN~ ~EDWIN2~ ~EDWIN4~ ~EDWIN6~ ~EDWIN7~ ~EDWIN7_~
    ~EDWIN9~ ~EDWIN11~ ~EDWIN12~ ~EDWIN13~ ~EDWIN15~
  BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%creature%.CRE~ BEGIN
      COPY_EXISTING ~%creature%.CRE~ ~override~
        SET repair_missing_kit = ~%creature%~ STRING_EQUAL_CASE ~EDWIN7_~
        LPF cbm_edwin_cre INT_VAR redwizard_id repair_missing_kit END
      BUT_ONLY
    END
  END
END
