// =====================================================================
// cbm_xan_ek_fix (component @170)
// Reconcile the EET Xan variants omitted by Artisan's Eldritch Knight NPC
// component. XAN_ is intentionally outside this component's scope.
// =====================================================================

// Resolve every installation-defined identifier and both XP progressions
// before opening a CRE for mutation. KIT.IDS stores the high word used by
// the CRE kit dword; XPLEVEL.2DA remains authoritative for split levels.
DEFINE_ACTION_FUNCTION cbm_xan_load_context
  RET
    cbm_xan_fighter_mage_class
    cbm_xan_eldritch_knight_kit
  RET_ARRAY
    cbm_xan_fighter_xp
    cbm_xan_mage_xp
BEGIN
  OUTER_SET cbm_xan_fighter_mage_class = (FILE_EXISTS_IN_GAME ~CLASS.IDS~ ? IDS_OF_SYMBOL (~class~ ~FIGHTER_MAGE~) : (0 - 1))
  ACTION_IF cbm_xan_fighter_mage_class < 0 BEGIN OUTER_SET cbm_xan_fighter_mage_class = 7 END
  OUTER_SET cbm_xan_kit_id = (FILE_EXISTS_IN_GAME ~KIT.IDS~ ? IDS_OF_SYMBOL (~kit~ ~C0EK~) : (0 - 1))
  OUTER_SET cbm_xan_eldritch_knight_kit = cbm_xan_kit_id * 0x10000
  LAF cbmo_read_table STR_VAR table = ~XPLEVEL~ RET_ARRAY cbmo_cell cbmo_column cbmo_cols END
  ACTION_CLEAR_ARRAY cbm_xan_fighter_xp
  ACTION_CLEAR_ARRAY cbm_xan_mage_xp
  OUTER_PATCH ~~ BEGIN
    FOR (level = 1; level <= 255; ++level) BEGIN
      LPF cbmo_number INT_VAR fallback = 2147483647 STR_VAR table = ~XPLEVEL~ row = ~FIGHTER~ column = EVAL ~%level%~ RET number END
      SET $cbm_xan_fighter_xp(~%level%~) = number < 0 ? 2147483647 : number
      LPF cbmo_number INT_VAR fallback = 2147483647 STR_VAR table = ~XPLEVEL~ row = ~MAGE~ column = EVAL ~%level%~ RET number END
      SET $cbm_xan_mage_xp(~%level%~) = number < 0 ? 2147483647 : number
    END
  END
END

DEFINE_PATCH_FUNCTION cbm_xan_make_eldritch_knight
  INT_VAR cbm_xan_fighter_mage_class = 0 cbm_xan_eldritch_knight_kit = 0
  STR_VAR cbm_xan_template = ~~
BEGIN
  LPF cbmo_cre_writable RET cbmo_writable END
  PATCH_IF cbmo_writable BEGIN
  READ_ASCII 0x00 cbm_xan_signature (8)
  READ_ASCII 0x280 cbm_xan_dv (32) NULL
  READ_LONG 0x18 cbm_xan_total_xp
  SPRINT cbm_xan_template EVALUATE_BUFFER ~%cbm_xan_template%~
  SPRINT cbm_xan_expected_dv ~XAN~
  SET cbm_xan_target_sling = 1
  PATCH_IF (~%cbm_xan_template%~ STRING_EQUAL_CASE ~XAN4~) BEGIN
    SET cbm_xan_target_current_hp = 18
    SET cbm_xan_target_maximum_hp = 21
    SET cbm_xan_target_sling = 0
  END ELSE PATCH_IF (~%cbm_xan_template%~ STRING_EQUAL_CASE ~XAN6~) BEGIN
    SET cbm_xan_target_current_hp = 30
    SET cbm_xan_target_maximum_hp = 35
  END ELSE PATCH_IF (~%cbm_xan_template%~ STRING_EQUAL_CASE ~TTXAN~) BEGIN
    SPRINT cbm_xan_expected_dv ~TTXAN~
    SET cbm_xan_target_current_hp = 35
    SET cbm_xan_target_maximum_hp = 35
  END ELSE BEGIN
    PATCH_FAIL ~cbm_xan_ek_fix: unsupported Xan template~
  END
  SET cbm_xan_target_fighter_level = 0
  SET cbm_xan_target_mage_level = 0
  SET cbm_xan_class_xp = cbm_xan_total_xp / 2
  FOR (cbm_xan_level = 1; cbm_xan_level <= 255; ++cbm_xan_level) BEGIN
    PATCH_IF VARIABLE_IS_SET $cbm_xan_fighter_xp(~%cbm_xan_level%~) BEGIN
      PATCH_IF ($cbm_xan_fighter_xp(~%cbm_xan_level%~) <= cbm_xan_class_xp) BEGIN
        SET cbm_xan_target_fighter_level = cbm_xan_level
      END
    END
    PATCH_IF VARIABLE_IS_SET $cbm_xan_mage_xp(~%cbm_xan_level%~) BEGIN
      PATCH_IF ($cbm_xan_mage_xp(~%cbm_xan_level%~) <= cbm_xan_class_xp) BEGIN
        SET cbm_xan_target_mage_level = cbm_xan_level
      END
    END
  END
  READ_BYTE 0x33 cbm_xan_effect_version
  READ_LONG 0x2c4 cbm_xan_effect_offset
  READ_LONG 0x2c8 cbm_xan_effect_count
  SET cbm_xan_effect_size = cbm_xan_effect_version = 1 ? 0x108 : 0x30
  LPF cbm_npc_clear_previous_kit INT_VAR target_kit = cbm_xan_eldritch_knight_kit END
  // A multiclass build has no inactive former class; preserve unrelated flags.
  WRITE_LONG 0x10 ((LONG_AT 0x10) BAND 0xfffffe07)
  // THAC0 and total XP stay as installed; the authored build fields are replaced.
  WRITE_BYTE 0x273 cbm_xan_fighter_mage_class
  WRITE_LONG 0x244 cbm_xan_eldritch_knight_kit
  WRITE_BYTE 0x234 cbm_xan_target_fighter_level
  WRITE_BYTE 0x235 cbm_xan_target_mage_level
  WRITE_BYTE 0x236 0
  WRITE_SHORT 0x24 cbm_xan_target_current_hp
  WRITE_SHORT 0x26 cbm_xan_target_maximum_hp
  LPF cbm_npc_clear_proficiencies END
  SET_BG2_PROFICIENCY 90 2
  SET_BG2_PROFICIENCY 96 1
  SET_BG2_PROFICIENCY 107 cbm_xan_target_sling
  SET_BG2_PROFICIENCY 113 1
  END ELSE BEGIN
    PATCH_PRINT ~CBM: %SOURCE_FILE% is too damaged to write; leaving this resource alone.~
  END
END
