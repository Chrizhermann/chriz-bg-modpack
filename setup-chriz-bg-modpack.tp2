// Kit-only Dwarven Defender default for Kagain. The collection is responsible
// for ordering Artisan's Shield Bash correction before this component.
BEGIN @194 DESIGNATED 194 GROUP @1100 LABEL ~cbm_kagain_dwarven_defender~
INCLUDE ~chriz-bg-modpack/lib/cbm_collection_defaults.tpa~
LAF cbm_collection_resolve_class STR_VAR symbol = ~FIGHTER~ RET class_id END
LAF cbm_collection_resolve_kit STR_VAR symbol = ~TRUECLASS~ RET kit_dword END
OUTER_SET cbm_kagain_source_kit = kit_dword
LAF cbm_collection_resolve_kit STR_VAR symbol = ~DWARVEN_DEFENDER~ RET kit_dword END
OUTER_SET cbm_kagain_target_kit = kit_dword
ACTION_FOR_EACH cbm_kagain_cre IN ~KAGAIN~ ~KAGAIN2~ ~KAGAIN4~ ~KAGAIN6~ BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%cbm_kagain_cre%.CRE~ BEGIN
  COPY_EXISTING ~%cbm_kagain_cre%.CRE~ ~override~
    LPF cbm_collection_make_kagain_dwarven_defender
      INT_VAR expected_class = class_id source_kit = cbm_kagain_source_kit target_kit = cbm_kagain_target_kit
      STR_VAR expected_dv = ~KAGAIN~
    END
  BUT_ONLY
  END ELSE BEGIN PRINT ~CBM: %cbm_kagain_cre%.CRE is absent.~ END
END

// Atomic Swashbuckler default: each CRE receives the kit and the component
// 160 skill redistribution in the same COPY transaction.
BEGIN @195 DESIGNATED 195 GROUP @1100 LABEL ~cbm_skie_swashbuckler~
INCLUDE ~chriz-bg-modpack/lib/cbm_collection_defaults.tpa~
INCLUDE ~chriz-bg-modpack/lib/cbm_skie_skill_fix.tpa~
LAF cbm_collection_resolve_class STR_VAR symbol = ~THIEF~ RET class_id END
LAF cbm_skie_load_context
  RET
    cbm_skie_thief_class = cbm_skie_thief_class
    cbm_skie_swashbuckler_kit = cbm_skie_swashbuckler_kit
END
LAF cbm_collection_resolve_kit STR_VAR symbol = ~TRUECLASS~ RET kit_dword END
OUTER_SET cbm_skie_source_kit = kit_dword
LAF cbm_collection_resolve_kit STR_VAR symbol = ~SWASHBUCKLER~ RET kit_dword END
OUTER_SET cbm_skie_target_kit = kit_dword
ACTION_FOR_EACH cbm_skie_cre IN ~SKIE~ ~SKIE6~ ~BDSKIE~ ~BDSKIED~ BEGIN
  OUTER_SPRINT cbm_skie_expected_dv ~%cbm_skie_cre%~
  ACTION_IF (~%cbm_skie_cre%~ STRING_EQUAL_CASE ~SKIE6~) BEGIN
    OUTER_SPRINT cbm_skie_expected_dv ~SKIE~
  END
  ACTION_IF FILE_EXISTS_IN_GAME ~%cbm_skie_cre%.CRE~ BEGIN
  COPY_EXISTING ~%cbm_skie_cre%.CRE~ ~override~
    LPF cbm_collection_make_skie_swashbuckler
      INT_VAR expected_class = class_id source_kit = cbm_skie_source_kit target_kit = cbm_skie_target_kit
      STR_VAR expected_dv = ~%cbm_skie_expected_dv%~
    END
    LPF cbm_skie_move_stealth_to_locks
      INT_VAR
        cbm_skie_thief_class = cbm_skie_thief_class
        cbm_skie_swashbuckler_kit = cbm_skie_target_kit
    END
  BUT_ONLY
  END ELSE BEGIN PRINT ~CBM: %cbm_skie_cre%.CRE is absent.~ END
END

// Kit-only Avenger default for Faldorn. Each present variant is patched and
// each missing one is reported; with none present nothing changes.
BEGIN @196 DESIGNATED 196 GROUP @1100 LABEL ~cbm_faldorn_avenger~
INCLUDE ~chriz-bg-modpack/lib/cbm_collection_defaults.tpa~
OUTER_SET cbm_faldorn_present = 0
ACTION_FOR_EACH cbm_faldorn_cre IN ~FALDOR~ ~FALDOR5~ BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%cbm_faldorn_cre%.CRE~ BEGIN
    OUTER_SET cbm_faldorn_present += 1
  END ELSE BEGIN
    PRINT ~ cbm_faldorn_avenger: %cbm_faldorn_cre%.CRE is missing; skipping this variant. Other or renamed variants may remain unpatched.~
  END
END
ACTION_IF (cbm_faldorn_present > 0) BEGIN
  LAF cbm_collection_resolve_class STR_VAR symbol = ~DRUID~ RET class_id END
  LAF cbm_collection_resolve_kit STR_VAR symbol = ~TRUECLASS~ RET kit_dword END
  OUTER_SET cbm_faldorn_source_kit = kit_dword
  LAF cbm_collection_resolve_kit STR_VAR symbol = ~BEASTFRIEND~ RET kit_dword END
  OUTER_SET cbm_faldorn_target_kit = kit_dword
  ACTION_FOR_EACH cbm_faldorn_cre IN ~FALDOR~ ~FALDOR5~ BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%cbm_faldorn_cre%.CRE~ BEGIN
      COPY_EXISTING ~%cbm_faldorn_cre%.CRE~ ~override~
        LPF cbm_collection_make_faldorn_avenger
          INT_VAR expected_class = class_id source_kit = cbm_faldorn_source_kit target_kit = cbm_faldorn_target_kit
          STR_VAR expected_dv = ~FALDORN~
        END
      BUT_ONLY
    END
  END
  PRINT ~cbm_faldorn_avenger: processed %cbm_faldorn_present% present Faldorn variant(s).~
END ELSE BEGIN
  PRINT ~ cbm_faldorn_avenger: no supported Faldorn variants found; no resources changed.~
END

// Add the effective installed WIZARD_HASTE spell to Dynaheir once. Each present
// variant is patched and each missing one is reported; with none present
// nothing changes.
BEGIN @197 DESIGNATED 197 GROUP @1100 LABEL ~cbm_dynaheir_haste~
INCLUDE ~chriz-bg-modpack/lib/cbm_collection_defaults.tpa~
OUTER_SET cbm_dynaheir_present = 0
ACTION_FOR_EACH cbm_dynaheir_cre IN ~DYNAHE~ ~DYNAHE2~ ~DYNAHE4~ ~DYNAHE6~ ~DYNAHE7~ BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%cbm_dynaheir_cre%.CRE~ BEGIN
    OUTER_SET cbm_dynaheir_present += 1
  END ELSE BEGIN
    PRINT ~ cbm_dynaheir_haste: %cbm_dynaheir_cre%.CRE is missing; skipping this variant. Other or renamed variants may remain unpatched.~
  END
END
ACTION_IF (cbm_dynaheir_present > 0) BEGIN
  LAF cbm_collection_resolve_class STR_VAR symbol = ~MAGE~ RET class_id END
  LAF cbm_collection_resolve_kit STR_VAR symbol = ~MAGESCHOOL_INVOKER~ RET kit_dword END
  OUTER_SET cbm_dynaheir_kit = kit_dword
  LAF cbm_collection_resolve_wizard_spell STR_VAR symbol = ~WIZARD_HASTE~ RET spell_resref END
  ACTION_FOR_EACH cbm_dynaheir_cre IN ~DYNAHE~ ~DYNAHE2~ ~DYNAHE4~ ~DYNAHE6~ ~DYNAHE7~ BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%cbm_dynaheir_cre%.CRE~ BEGIN
      OUTER_SPRINT cbm_dynaheir_dv ~Dynaheir~
      ACTION_IF (~%cbm_dynaheir_cre%~ STRING_EQUAL_CASE ~DYNAHE7~) BEGIN
        OUTER_SPRINT cbm_dynaheir_dv ~DYNAHEIR~
      END
      COPY_EXISTING ~%cbm_dynaheir_cre%.CRE~ ~override~
        LPF cbm_collection_add_dynaheir_haste
          INT_VAR expected_class = class_id expected_kit = cbm_dynaheir_kit
          STR_VAR expected_dv = ~%cbm_dynaheir_dv%~ haste_resref = ~%spell_resref%~
        END
      BUT_ONLY
    END
  END
  PRINT ~cbm_dynaheir_haste: processed %cbm_dynaheir_present% present Dynaheir variant(s).~
END ELSE BEGIN
  PRINT ~ cbm_dynaheir_haste: no supported Dynaheir variants found; no resources changed.~
END

