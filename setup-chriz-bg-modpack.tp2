// =====================================================================
// Gameplay tweaks (600-699)
// =====================================================================

// Shared progression for locks, traps and scribing, independent of the acting
// character's class-level slots. Configurable; requires the EEex runtime.
BEGIN @610 DESIGNATED 610 GROUP @1600 LABEL ~cbm_utility_xp~
  REQUIRE_PREDICATE (NOT MOD_IS_INSTALLED ~setup-chriz-bg-modpack.tp2~ 611) @1614
  REQUIRE_PREDICATE GAME_IS ~bg2ee eet~ @1610
  REQUIRE_PREDICATE FILE_EXISTS ~override/M___EEex.lua~ @1611
  REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~XPBONUS.2DA~ AND FILE_EXISTS_IN_GAME ~XPLEVEL.2DA~) @1612
INCLUDE ~chriz-bg-modpack/lib/cbm_utility_xp.tpa~

