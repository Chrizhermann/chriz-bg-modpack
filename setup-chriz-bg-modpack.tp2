BACKUP ~weidu_external/backup/chriz-bg-modpack~
AUTHOR ~Christopher Hermann (github.com/Chrizhermann/chriz-bg-modpack)~
VERSION ~v0.2.0-alpha.5~

AUTO_TRA ~chriz-bg-modpack/languages/%s~
LANGUAGE ~English~ ~english~ ~chriz-bg-modpack/languages/english/setup.tra~

// Public alpha: every advertised component below contains installable source.
// Deferred and private component numbers are not exposed.

// =====================================================================
// NPC fixes and optional collection defaults (100-199)
// =====================================================================

// Convert both shipped Fade profiles to Fighter/Thief, reconcile their split
// levels and authored build, and allow the converted class to use her amulet.
// This complete component supersedes the former component 120.
BEGIN @110 DESIGNATED 110 GROUP @1100 LABEL ~cbm_fade_ft_fix~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~E3FADE13.CRE~
    ~cbm_fade_ft_fix: E3FADE13.CRE is missing - install Fade first.~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~E3FADE25.CRE~
    ~cbm_fade_ft_fix: E3FADE25.CRE is missing - the Fade installation is incomplete.~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~E3AMUL01.ITM~
    ~cbm_fade_ft_fix: E3AMUL01.ITM is missing - the Fade installation is incomplete.~
INCLUDE ~chriz-bg-modpack/lib/cbm_fade_ft_fix.tpa~
LAF cbm_fade_load_context
  RET
    cbm_fade_thief_class = cbm_fade_thief_class
    cbm_fade_fighter_thief_class = cbm_fade_fighter_thief_class
  RET_ARRAY
    cbm_fade_fighter_xp = cbm_fade_fighter_xp
    cbm_fade_thief_xp = cbm_fade_thief_xp
END
ACTION_FOR_EACH cbm_fade_cre IN ~E3FADE13~ ~E3FADE25~ BEGIN
  COPY_EXISTING ~%cbm_fade_cre%.CRE~ ~override~
    LPF cbm_fade_make_fighter_thief
      INT_VAR
        cbm_fade_thief_class = cbm_fade_thief_class
        cbm_fade_fighter_thief_class = cbm_fade_fighter_thief_class
    END
  BUT_ONLY
END
COPY_EXISTING ~E3AMUL01.ITM~ ~override~
  LPF cbm_fade_allow_fighter_thief END
BUT_ONLY

// Compile first-party override guards for the two BG1NPC Kivan quest
// sahuagin so SCS combat AI cannot pre-empt their dialogue phase.
BEGIN @130 DESIGNATED 130 GROUP @1100 LABEL ~cbm_kivan_quest_fix~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~X#SAHA01.CRE~
    ~cbm_kivan_quest_fix: X#SAHA01.CRE is missing - install the BG1NPC Kivan quest first.~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~X#SAHA02.CRE~
    ~cbm_kivan_quest_fix: X#SAHA02.CRE is missing - the BG1NPC Kivan quest is incomplete.~
COPY ~chriz-bg-modpack/baf/cbm_kivan_saha01.baf~ ~override/X#SAHA01.BCS~
  COMPILE_BAF_TO_BCS
COPY ~chriz-bg-modpack/baf/cbm_kivan_saha02.baf~ ~override/X#SAHA02.BCS~
  COMPILE_BAF_TO_BCS

// Move Mazzy's illegal fifth Short Bow pip to Short Sword across all five
// shipped BG2 variants.
BEGIN @140 DESIGNATED 140 GROUP @1100 LABEL ~cbm_mazzy_prof_fix~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~MAZZY8.CRE~ ~cbm_mazzy_prof_fix: MAZZY8.CRE is missing.~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~MAZZY9.CRE~ ~cbm_mazzy_prof_fix: MAZZY9.CRE is missing.~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~MAZZY11.CRE~ ~cbm_mazzy_prof_fix: MAZZY11.CRE is missing.~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~MAZZY12.CRE~ ~cbm_mazzy_prof_fix: MAZZY12.CRE is missing.~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~MAZZY15.CRE~ ~cbm_mazzy_prof_fix: MAZZY15.CRE is missing.~
INCLUDE ~chriz-bg-modpack/lib/cbm_mazzy_prof_fix.tpa~
ACTION_FOR_EACH cbm_mazzy_cre IN ~MAZZY8~ ~MAZZY9~ ~MAZZY11~ ~MAZZY12~ ~MAZZY15~ BEGIN
  COPY_EXISTING ~%cbm_mazzy_cre%.CRE~ ~override~
    LPF cbm_mazzy_move_bow_pip END
  BUT_ONLY
END

// Standalone form of Skie's post-Swashbuckler skill repair. It is also invoked
// atomically by the recommended Swashbuckler default at component 195.
BEGIN @160 DESIGNATED 160 GROUP @1100 LABEL ~cbm_skie_skill_fix~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~SKIE.CRE~ ~cbm_skie_skill_fix: SKIE.CRE is missing - expected EET resources.~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~SKIE6.CRE~ ~cbm_skie_skill_fix: SKIE6.CRE is missing - expected EET resources.~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~BDSKIE.CRE~ ~cbm_skie_skill_fix: BDSKIE.CRE is missing - expected EET resources.~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~BDSKIED.CRE~ ~cbm_skie_skill_fix: BDSKIED.CRE is missing - expected EET resources.~
INCLUDE ~chriz-bg-modpack/lib/cbm_skie_skill_fix.tpa~
LAF cbm_skie_load_context
  RET
    cbm_skie_thief_class = cbm_skie_thief_class
    cbm_skie_swashbuckler_kit = cbm_skie_swashbuckler_kit
END
ACTION_FOR_EACH cbm_skie_cre IN ~SKIE~ ~SKIE6~ ~BDSKIE~ ~BDSKIED~ BEGIN
  COPY_EXISTING ~%cbm_skie_cre%.CRE~ ~override~
    LPF cbm_skie_move_stealth_to_locks
      INT_VAR
        cbm_skie_thief_class = cbm_skie_thief_class
        cbm_skie_swashbuckler_kit = cbm_skie_swashbuckler_kit
    END
  BUT_ONLY
END

// Artisan's Xan component handles XAN_ itself. Reconcile only the three EET
// variants it does not patch, retaining their installed THAC0 values.
BEGIN @170 DESIGNATED 170 GROUP @1100 LABEL ~cbm_xan_ek_fix~
  REQUIRE_PREDICATE (GAME_IS ~eet~) ~cbm_xan_ek_fix: this component is for EET only.~
  REQUIRE_COMPONENT ~ArtisansKitpack/ArtisansKitpack.tp2~ ~20000~
    ~cbm_xan_ek_fix: install Artisan's Eldritch Knight kit component 20000 first.~
  REQUIRE_COMPONENT ~ArtisansKitpack_npc/ArtisansKitpack_npc.tp2~ ~20002~
    ~cbm_xan_ek_fix: install Artisan's Xan Eldritch Knight component 20002 first.~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~XAN4.CRE~ ~cbm_xan_ek_fix: XAN4.CRE is missing.~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~XAN6.CRE~ ~cbm_xan_ek_fix: XAN6.CRE is missing.~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~TTXAN.CRE~ ~cbm_xan_ek_fix: TTXAN.CRE is missing.~
INCLUDE ~chriz-bg-modpack/lib/cbm_xan_ek_fix.tpa~
LAF cbm_xan_load_context
  RET
    cbm_xan_mage_class = cbm_xan_mage_class
    cbm_xan_fighter_mage_class = cbm_xan_fighter_mage_class
    cbm_xan_enchanter_kit = cbm_xan_enchanter_kit
    cbm_xan_eldritch_knight_kit = cbm_xan_eldritch_knight_kit
  RET_ARRAY
    cbm_xan_fighter_xp = cbm_xan_fighter_xp
    cbm_xan_mage_xp = cbm_xan_mage_xp
END
ACTION_FOR_EACH cbm_xan_cre IN ~XAN4~ ~XAN6~ ~TTXAN~ BEGIN
  COPY_EXISTING ~%cbm_xan_cre%.CRE~ ~override~
    LPF cbm_xan_make_eldritch_knight
      INT_VAR
        cbm_xan_mage_class = cbm_xan_mage_class
        cbm_xan_fighter_mage_class = cbm_xan_fighter_mage_class
        cbm_xan_enchanter_kit = cbm_xan_enchanter_kit
        cbm_xan_eldritch_knight_kit = cbm_xan_eldritch_knight_kit
    END
  BUT_ONLY
END

// Optional Sarah ToB v8 conversion. The collection selects this by default,
// but users may omit it to keep Sarah's normal kit and proficiencies.
BEGIN @190 DESIGNATED 190 GROUP @1100 LABEL ~cbm_sarah_archer~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~K#SARAH.CRE~ ~cbm_sarah_archer: K#SARAH.CRE is missing - install Sarah ToB v8 first.~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~K#SARAH1.CRE~ ~cbm_sarah_archer: K#SARAH1.CRE is missing - the Sarah installation is incomplete.~
INCLUDE ~chriz-bg-modpack/lib/cbm_sarah_archer.tpa~
ACTION_FOR_EACH cbm_sarah_cre IN ~K#SARAH~ ~K#SARAH1~ BEGIN
  COPY_EXISTING ~%cbm_sarah_cre%.CRE~ ~override~
    LPF cbm_sarah_make_archer END
  BUT_ONLY
END
PRINT ~[cbm_sarah_archer] Sarah converted to Archer with Long Bow 3, Long Sword 1, Short Bow 2, and Two-Weapon Style 2.~

// Component 191 is reserved for a private portrait overlay and intentionally
// absent from this public installer.

// Convert the ten explicit EET Viconia resources to a permanent true-class
// Cleric/Thief using the installed progression tables.
BEGIN @192 DESIGNATED 192 GROUP @1100 LABEL ~cbm_viconia_cleric_thief~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~VICONI.CRE~ ~cbm_viconia_cleric_thief: VICONI.CRE is missing - expected EET resources.~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~VICONI4.CRE~ ~cbm_viconia_cleric_thief: VICONI4.CRE is missing.~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~VICONI6_.CRE~ ~cbm_viconia_cleric_thief: VICONI6_.CRE is missing.~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~VICONI6.CRE~ ~cbm_viconia_cleric_thief: VICONI6.CRE is missing.~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~VICONI7.CRE~ ~cbm_viconia_cleric_thief: VICONI7.CRE is missing.~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~VICONI8.CRE~ ~cbm_viconia_cleric_thief: VICONI8.CRE is missing.~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~VICONI9.CRE~ ~cbm_viconia_cleric_thief: VICONI9.CRE is missing.~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~VICONI11.CRE~ ~cbm_viconia_cleric_thief: VICONI11.CRE is missing.~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~VICONI13.CRE~ ~cbm_viconia_cleric_thief: VICONI13.CRE is missing.~
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~VICONI16.CRE~ ~cbm_viconia_cleric_thief: VICONI16.CRE is missing.~
INCLUDE ~chriz-bg-modpack/lib/cbm_viconia_cleric_thief.tpa~
LAF cbm_viconia_load_context
  RET
    cbm_viconia_cleric_class = cbm_viconia_cleric_class
    cbm_viconia_cleric_thief_class = cbm_viconia_cleric_thief_class
    cbm_viconia_cleric_lore_rate = cbm_viconia_cleric_lore_rate
    cbm_viconia_thief_lore_rate = cbm_viconia_thief_lore_rate
  RET_ARRAY
    cbm_viconia_cleric_xp = cbm_viconia_cleric_xp
    cbm_viconia_thief_xp = cbm_viconia_thief_xp
    cbm_viconia_priest_slots = cbm_viconia_priest_slots
    cbm_viconia_priest_saves = cbm_viconia_priest_saves
    cbm_viconia_rogue_saves = cbm_viconia_rogue_saves
    cbm_viconia_cleric_thac0 = cbm_viconia_cleric_thac0
    cbm_viconia_thief_thac0 = cbm_viconia_thief_thac0
END
ACTION_FOR_EACH cbm_viconia_cre IN
  ~VICONI~ ~VICONI4~ ~VICONI6_~ ~VICONI6~ ~VICONI7~
  ~VICONI8~ ~VICONI9~ ~VICONI11~ ~VICONI13~ ~VICONI16~
BEGIN
  COPY_EXISTING ~%cbm_viconia_cre%.CRE~ ~override~
    LPF cbm_viconia_make_cleric_thief END
  BUT_ONLY
END
PRINT ~[cbm_viconia_cleric_thief] Ten Viconia variants converted with installed-table THAC0, Lore, saves, and priest slots.~

