// =====================================================================
// Gameplay tweaks (600-699)
// =====================================================================

// Shared progression for locks, traps and scribing, independent of the acting
// character's class-level slots. Configurable; requires the EEex runtime.
BEGIN @610 DESIGNATED 610 GROUP @1600 LABEL ~cbm_utility_xp~
  REQUIRE_PREDICATE (NOT MOD_IS_INSTALLED ~setup-chriz-bg-modpack.tp2~ 611) @1614
  REQUIRE_PREDICATE GAME_IS ~bg2ee eet~ @1610
  REQUIRE_PREDICATE FILE_EXISTS ~override/M___EEex.lua~ @1611
INCLUDE ~chriz-bg-modpack/lib/cbm_utility_xp.tpa~

// Campaign identity and EET flags distinguish the overlapping chapters.
BEGIN @611 DESIGNATED 611 GROUP @1600 LABEL ~cbm_story_utility_xp~
  REQUIRE_PREDICATE (NOT MOD_IS_INSTALLED ~setup-chriz-bg-modpack.tp2~ 610) @1614
  REQUIRE_PREDICATE GAME_IS ~eet~ @1615
  REQUIRE_PREDICATE FILE_EXISTS ~override/M___EEex.lua~ @1616
INCLUDE ~chriz-bg-modpack/lib/cbm_story_utility_xp.tpa~

// One-time Spellhold catch-up: exact party-average XP, capped at 3M mage XP.
BEGIN @620 DESIGNATED 620 GROUP @1600 LABEL ~cbm_imoen_spellhold_xp~
  REQUIRE_PREDICATE GAME_IS ~bg2ee eet~ @1620
  REQUIRE_PREDICATE FILE_EXISTS ~override/M___EEex.lua~ @1621
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~imoen2.bcs~ @1622
INCLUDE ~chriz-bg-modpack/lib/cbm_imoen_spellhold_xp.tpa~

// Presentation only; ordinary loot randomization remains compatible.
BEGIN @630 DESIGNATED 630 GROUP @1600 LABEL ~cbm_unidentified_appearance~
  REQUIRE_PREDICATE GAME_IS ~bg2ee eet~ @1630
  REQUIRE_PREDICATE (FILE_EXISTS ~override/M___EEex.lua~ AND FILE_EXISTS ~InfinityLoader.db~ AND FILE_EXISTS ~Baldur.exe~) @1631
INCLUDE ~chriz-bg-modpack/lib/cbm_unidentified_appearance.tpa~

// Load before legacy skins capture t(); preserve any already-working helper.
BEGIN @640 DESIGNATED 640 GROUP @1400 LABEL ~cbm_legacy_ui_strings~
  REQUIRE_PREDICATE GAME_IS ~bg2ee eet~ @1640
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~UTIL.LUA~ @1641
INCLUDE ~chriz-bg-modpack/lib/cbm_legacy_ui_strings.tpa~
PRINT @1642

// Optional quest choice: hand the Helm of Balduran to Degrodel (unchanged) or
// keep it and fight him with the servants the installed hand-in summons.
BEGIN @660 DESIGNATED 660 GROUP @1600 LABEL ~cbm_degrodel_fight~
  REQUIRE_PREDICATE GAME_IS ~bgee eet~ @1660
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~DEGROD.DLG~ @1661
INCLUDE ~chriz-bg-modpack/lib/cbm_degrodel_fight.tpa~

// BG1 source of the Boomerang Dagger +2 (DAGG11) without BG1 NPC Project's
// Kivan quest: both Marek files carry it, so whichever Marek dies drops it.
// No second dagger when that quest already gives one.
BEGIN @670 DESIGNATED 670 GROUP @1600 LABEL ~cbm_marek_boomerang_dagger~
  REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~MAREK.CRE~ OR FILE_EXISTS_IN_GAME ~MAREK1.CRE~) @6701
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~DAGG11.ITM~ @6702
INCLUDE ~chriz-bg-modpack/lib/cbm_marek_boomerang_dagger.tpa~

// Experimental/unreleased opt-in source; neither component installs by default.
BEGIN @650 DESIGNATED 650 GROUP @1600 LABEL ~cbm_campaign_xp~
  REQUIRE_PREDICATE GAME_IS ~eet~ @1650
  REQUIRE_PREDICATE (FILE_EXISTS ~override/M___EEex.lua~ AND FILE_EXISTS ~InfinityLoader.db~
    AND FILE_EXISTS ~Baldur.exe~ AND FILE_EXISTS ~EEex.dll~ AND FILE_EXISTS ~LuaBindings.dll~
    AND FILE_EXISTS ~LuaProvider.dll~ AND FILE_EXISTS ~InfinityLoaderDLL.dll~) @1651
INCLUDE ~chriz-bg-modpack/lib/cbm_campaign_xp.tpa~

