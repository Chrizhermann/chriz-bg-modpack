BEGIN @189 DESIGNATED 189 GROUP @1100 LABEL ~cbm_safana_inventory~
  REQUIRE_PREDICATE GAME_IS ~eet~ @1991
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~ar0311.bcs~ @1892
INCLUDE ~chriz-bg-modpack/lib/cbm_safana_inventory.tpa~

// Optional Sarah ToB v8 conversion. The collection selects this by default,
