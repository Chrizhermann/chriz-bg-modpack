  REQUIRE_PREDICATE (NOT MOD_IS_INSTALLED ~setup-chriz-bg-modpack.tp2~ 652) @1656
COPY ~chriz-bg-modpack/campaign-xp/cbmbksoa.lua~ ~override/CBMBKCFG.lua~
PRINT @1655

BEGIN @652 DESIGNATED 652 GROUP @1600 LABEL ~cbm_campaign_xp_chapters~
