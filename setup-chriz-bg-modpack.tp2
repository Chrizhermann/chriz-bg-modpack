BEGIN @188 DESIGNATED 188 GROUP @1100 LABEL ~cbm_yeslick_alaghor~
  REQUIRE_PREDICATE GAME_IS ~eet~ @1991
  REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~qd_multi.qd~ @1883
  REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~KIT.IDS~ ? IDS_OF_SYMBOL (~KIT~ ~LK_ALAGHOR~) >= 0 : 0) ~Yeslick: the Alaghor kit must be available.~
INCLUDE ~chriz-bg-modpack/lib/cbm_yeslick_alaghor.tpa~
LAF cbmy_install END

